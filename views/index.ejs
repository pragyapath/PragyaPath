<script>
(function() {
  // All gallery images data
  var allImages = [
    { src: '/images/gallery/sound-healing-group.webp', alt: 'Group Healing Session', cat: 'healing' },
    { src: '/images/gallery/girl-with-tibetean-bowl.webp', alt: 'Tibetan Bowl Practice', cat: 'healing' },
    { src: '/images/gallery/healing-sound.webp', alt: 'Sound Resonance', cat: 'healing' },
    { src: '/images/gallery/with-foregin-guest-group-photo.webp', alt: 'Global Community', cat: 'community' },
    { src: '/images/gallery/yoda-session.webp', alt: 'Hatha Yoga Flow', cat: 'yoga' },
    { src: '/images/gallery/sound-healing-glimp.webp', alt: 'Vibrational Therapy', cat: 'healing' },
    { src: '/images/gallery/yoga-traning.webp', alt: 'Teacher Training', cat: 'training' },
    { src: '/images/gallery/sound-healing.webp', alt: 'Deep Meditation', cat: 'healing' },
    { src: '/images/gallery/group-photo-with-guest.webp', alt: 'Sangha & Connection', cat: 'community' },
    { src: '/images/gallery/sound-healing.webp', alt: 'Acoustic Healing', cat: 'healing' },
    { src: '/images/gallery/2o3a5972.webp', alt: 'Yoga Session 1', cat: 'yoga' },
    { src: '/images/gallery/2o3a5975.webp', alt: 'Yoga Session 2', cat: 'yoga' },
    { src: '/images/gallery/2o3a5978.webp', alt: 'Yoga Session 3', cat: 'yoga' },
    { src: '/images/gallery/2o3a5983.webp', alt: 'Yoga Session 4', cat: 'yoga' },
    { src: '/images/gallery/2o3a5994.webp', alt: 'Sound Healing 1', cat: 'healing' },
    { src: '/images/gallery/2o3a5996.webp', alt: 'Sound Healing 2', cat: 'healing' },
    { src: '/images/gallery/2o3a5997.webp', alt: 'Sound Healing 3', cat: 'healing' },
    { src: '/images/gallery/2o3a5999.webp', alt: 'Sound Healing 4', cat: 'healing' },
    { src: '/images/gallery/2o3a6000.webp', alt: 'Sound Healing 5', cat: 'healing' },
    { src: '/images/gallery/2o3a6004.webp', alt: 'Meditation Practice', cat: 'healing' },
    { src: '/images/gallery/2o3a6005.webp', alt: 'Yoga Practice 1', cat: 'yoga' },
    { src: '/images/gallery/2o3a6009.webp', alt: 'Yoga Practice 2', cat: 'yoga' },
    { src: '/images/gallery/2o3a6010.webp', alt: 'Yoga Practice 3', cat: 'yoga' },
    { src: '/images/gallery/2o3a6012.webp', alt: 'Training 1', cat: 'training' },
    { src: '/images/gallery/2o3a6013.webp', alt: 'Training 2', cat: 'training' },
    { src: '/images/gallery/2o3a6014.webp', alt: 'Training 3', cat: 'training' },
    { src: '/images/gallery/2o3a6019.webp', alt: 'Singing Bowl', cat: 'healing' },
    { src: '/images/gallery/2o3a6022.webp', alt: 'Yoga Flow 1', cat: 'yoga' },
    { src: '/images/gallery/2o3a6023.webp', alt: 'Yoga Flow 2', cat: 'yoga' },
    { src: '/images/gallery/2o3a6024.webp', alt: 'Yoga Flow 3', cat: 'yoga' },
    { src: '/images/gallery/2o3a6025.webp', alt: 'Sound Therapy', cat: 'healing' },
    { src: '/images/gallery/2o3a6027.webp', alt: 'Group Practice', cat: 'community' },
    { src: '/images/gallery/2o3a6029.webp', alt: 'Community Session', cat: 'community' },
    { src: '/images/gallery/2o3a6034.webp', alt: 'Yoga Class 1', cat: 'yoga' },
    { src: '/images/gallery/2o3a6035.webp', alt: 'Yoga Class 2', cat: 'yoga' },
    { src: '/images/gallery/2o3a6038.webp', alt: 'Healing Circle', cat: 'healing' },
    { src: '/images/gallery/2o3a6039.webp', alt: 'Sound Bath', cat: 'healing' },
    { src: '/images/gallery/2o3a6040.webp', alt: 'Meditation Group', cat: 'healing' },
    { src: '/images/gallery/2o3a6041.webp', alt: 'Yoga Retreat 1', cat: 'training' },
    { src: '/images/gallery/2o3a6042.webp', alt: 'Yoga Retreat 2', cat: 'training' },
    { src: '/images/gallery/2o3a6044.webp', alt: 'Bowl Healing', cat: 'healing' },
    { src: '/images/gallery/2o3a6045.webp', alt: 'Sound Session', cat: 'healing' },
    { src: '/images/gallery/2o3a6047.webp', alt: 'Yoga Workshop', cat: 'training' },
    { src: '/images/gallery/2o3a6054.webp', alt: 'Group Healing 2', cat: 'healing' },
    { src: '/images/gallery/2o3a6056.webp', alt: 'Yoga Practice 4', cat: 'yoga' },
    { src: '/images/gallery/2o3a6060.webp', alt: 'Sound Healing 6', cat: 'healing' },
    { src: '/images/gallery/2o3a6062.webp', alt: 'Yoga Session 5', cat: 'yoga' },
    { src: '/images/gallery/2o3a6064.webp', alt: 'Meditation Session', cat: 'healing' },
    { src: '/images/gallery/2o3a6066.webp', alt: 'Training Workshop', cat: 'training' },
    { src: '/images/gallery/2o3a6068.webp', alt: 'Final Session', cat: 'community' }
  ];

  var currentFilter = 'all';
  var lightboxIndex = 0;
  var filteredImages = allImages.slice();

  // Elements
  var modal = document.getElementById('gallery-modal');
  var lightbox = document.getElementById('lightbox');
  var modalGrid = document.getElementById('modal-gallery-grid');
  var modalCounter = document.getElementById('modal-counter');
  var lightboxImg = document.getElementById('lightbox-img');
  var lightboxCounter = document.getElementById('lightbox-counter');


  // View All button - open modal
  document.getElementById('view-all-btn').addEventListener('click', function() {
    currentFilter = 'all';
    renderModal();
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  });

  // Close modal
  document.getElementById('modal-close-btn').addEventListener('click', function() {
    modal.classList.remove('active');
    document.body.style.overflow = '';
  });

  // Modal filter buttons
  document.getElementById('modal-filters').addEventListener('click', function(e) {
    var btn = e.target.closest('.modal-filter');
    if (!btn) return;
    
    document.querySelectorAll('.modal-filter').forEach(function(b) {
      b.classList.remove('active', 'bg-gold/10', 'text-gold', 'border-gold');
      b.classList.add('text-muted', 'border-line');
    });
    btn.classList.add('active', 'bg-gold/10', 'text-gold', 'border-gold');
    btn.classList.remove('text-muted', 'border-line');
    
    currentFilter = btn.getAttribute('data-filter');
    renderModal();
  });

  function renderModal() {
    filteredImages = currentFilter === 'all' ? allImages.slice() : allImages.filter(function(img) { return img.cat === currentFilter; });
    modalCounter.textContent = filteredImages.length + ' photos';

    var html = '';
    filteredImages.forEach(function(img, i) {
      html += '<div class="gallery-masonry-item img-hover cursor-pointer" data-idx="' + i + '">' +
        '<img src="' + img.src.replace(/\.webp$/, '-sm.webp') + '" alt="' + img.alt + '" class="w-full object-cover" loading="lazy" decoding="async">' +
        '<div class="img-caption"><p class="font-ui text-sm font-medium text-white">' + img.alt + '</p></div>' +
        '</div>';
    });
    modalGrid.innerHTML = html;

    // Add click handlers to modal images
    modalGrid.querySelectorAll('[data-idx]').forEach(function(el) {
      el.addEventListener('click', function() {
        lightboxIndex = parseInt(this.getAttribute('data-idx'));
        openLightbox();
      });
    });
  }

  // Lightbox
  function openLightbox() {
    var img = filteredImages[lightboxIndex];
    lightboxImg.src = img.src;
    lightboxImg.alt = img.alt;
    lightboxCounter.textContent = (lightboxIndex + 1) + ' / ' + filteredImages.length;
    lightbox.classList.add('active');
  }

  document.getElementById('lightbox-close-btn').addEventListener('click', function() {
    lightbox.classList.remove('active');
  });

  document.getElementById('lightbox-prev-btn').addEventListener('click', function() {
    lightboxIndex = (lightboxIndex - 1 + filteredImages.length) % filteredImages.length;
    openLightbox();
  });

  document.getElementById('lightbox-next-btn').addEventListener('click', function() {
    lightboxIndex = (lightboxIndex + 1) % filteredImages.length;
    openLightbox();
  });

  // Keyboard
  document.addEventListener('keydown', function(e) {
    if (lightbox.classList.contains('active')) {
      if (e.key === 'Escape') lightbox.classList.remove('active');
      if (e.key === 'ArrowLeft') { lightboxIndex = (lightboxIndex - 1 + filteredImages.length) % filteredImages.length; openLightbox(); }
      if (e.key === 'ArrowRight') { lightboxIndex = (lightboxIndex + 1) % filteredImages.length; openLightbox(); }
    } else if (modal.classList.contains('active')) {
      if (e.key === 'Escape') { modal.classList.remove('active'); document.body.style.overflow = ''; }
    }
  });

  // Click outside modal to close
  modal.addEventListener('click', function(e) {
    if (e.target === modal) {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }
  });
})();
</script>


