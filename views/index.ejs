            <label for="email" class="form-label">Email *</label>
            <% if (errors.email) { %>
            <p class="mt-2 text-sm font-ui text-red-700" role="alert"><%= errors.email %></p>
            <% } %>
          </div>
        </div>

        <div class="form-group">
          <input
            type="tel" id="phone" name="phone"
            value="<%= values.phone || '' %>"
            placeholder=" "
            class="form-input <%= errors.phone ? 'form-input-error' : '' %>"
            autocomplete="tel"
          >
          <label for="phone" class="form-label">Phone <span class="font-normal text-muted">(optional)</span></label>
          <% if (errors.phone) { %>
          <p class="mt-2 text-sm font-ui text-red-700" role="alert"><%= errors.phone %></p>
          <% } %>
        </div>

        <fieldset class="chips">
          <legend class="form-label">What are you interested in?</legend>
          <div class="chips-row">
            <% ['Yoga classes', 'Sound healing', 'Teacher or bowl training', 'Retreats and hikes', 'Drawing classes'].forEach(function(c) { %>
            <button type="button" class="chip" data-chip="<%= c %>" aria-pressed="false"><%= c %></button>
            <% }) %>
          </div>
        </fieldset>

        <div class="form-group">
          <textarea
            id="message" name="message"
            rows="5"
            placeholder=" "
            required
            class="form-input resize-none <%= errors.message ? 'form-input-error' : '' %>"
          ><%= values.message || '' %></textarea>
          <label for="message" class="form-label">Message *</label>
          <% if (errors.message) { %>
          <p class="mt-2 text-sm font-ui text-red-700" role="alert"><%= errors.message %></p>
          <% } %>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center gap-4 pt-2">
          <button type="submit" id="submit-btn" class="btn-primary sm:min-w-[14rem]">
            <span>Send message</span>
          </button>
          <p class="text-sm text-muted">We only use your details to reply to you.</p>
        </div>
      </form>
      </div>
    </div>

  </div>
</section>

</main>

<!-- Scroll reveal -->
<a id="wa-fab" href="<%= waLink %>" target="_blank" rel="noopener noreferrer" class="wa-fab is-hidden" aria-label="Message Pragya Path on WhatsApp"><%- waIcon %></a>

<script>
(function () {
  // Hero reveal animations — fire immediately
  document.querySelectorAll('.hero-reveal').forEach(function (el) { el.classList.add('visible'); });

  // ── Stagger-child observer ──────────────────────────────────────────────
  // When a parent container scrolls into view, reveal its children sequentially.
  var staggerParents = new Set();
  document.querySelectorAll('.stagger-child').forEach(function(el) {
    staggerParents.add(el.parentElement);
  });

  var staggerIO = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (!entry.isIntersecting) return;
      var children = Array.from(entry.target.querySelectorAll('.stagger-child'));
      children.forEach(function(child, i) {
        setTimeout(function() {
          child.classList.add('visible');
        }, i * 75);
      });
      staggerIO.unobserve(entry.target);
    });
  }, { threshold: 0.08 });

  staggerParents.forEach(function(parent) { staggerIO.observe(parent); });

  // ── Fade-up observer ───────────────────────────────────────────────────
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.fade-up').forEach(function (el) { io.observe(el); });

  // ── Counter animation ──────────────────────────────────────────────────
  function animateCounter(el) {
    var target = parseInt(el.getAttribute('data-target'), 10);
    var suffix = el.getAttribute('data-suffix') || '';
    if (isNaN(target)) return;
    var duration = 1200;
    var start = null;
    function step(ts) {
      if (!start) start = ts;
      var progress = Math.min((ts - start) / duration, 1);
      // Ease out cubic
      var eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.round(eased * target) + suffix;
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }
  var counterIO = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (!entry.isIntersecting) return;
      animateCounter(entry.target);
      counterIO.unobserve(entry.target);
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.stat-count[data-target]').forEach(function(el) {
    counterIO.observe(el);
  });

  // ── Lazy image loading ─────────────────────────────────────────────────
  document.querySelectorAll('img[loading="lazy"]').forEach(function (img) {
    if (img.complete) {
      img.classList.add('loaded');
    } else {
      img.addEventListener('load', function () { img.classList.add('loaded'); });
    }
  });

  // ── Parallax hover — Gratitude & About image blocks ───────────────────
  // Each group: [data-parallax-backing] tilts more, [data-parallax-main] lifts,
  // [data-parallax-float] lifts + rotates, inner img greyscale clears.
  document.querySelectorAll('[data-parallax-main]').forEach(function(main) {
    var group = main.closest('.group, [class*="group"]') || main.parentElement;
    var backing = group.querySelector('[data-parallax-backing]');
    var floatEl = group.querySelector('[data-parallax-float]');
    var floatImg = floatEl ? floatEl.querySelector('img') : null;

    group.addEventListener('mouseenter', function() {
      if (main)    main.style.transform    = 'translateY(-10px) translateZ(0)';
      if (backing) backing.style.transform = 'rotate(5deg) scale(1.05)';
      if (floatEl) floatEl.style.transform = 'translateY(-12px) rotate(4deg) scale(1.04) translateZ(0)';
      if (floatImg) {
        floatImg.style.filter  = 'grayscale(0)';
        floatImg.style.opacity = '1';
      }
    });
    group.addEventListener('mouseleave', function() {
      if (main)    main.style.transform    = 'translateY(0) translateZ(0)';
      if (backing) backing.style.transform = 'rotate(3deg) scale(1.05)';
      if (floatEl) floatEl.style.transform = 'translateY(0) rotate(0deg) scale(1) translateZ(0)';
      if (floatImg) {
        floatImg.style.filter  = 'grayscale(1)';
        floatImg.style.opacity = '0.8';
      }
    });
  });

  // ── Form submit state ──────────────────────────────────────────────────
  var form = document.getElementById('inquiry-form');
  var btn  = document.getElementById('submit-btn');
  if (form && btn) {
    form.addEventListener('submit', function () {
      btn.innerHTML = '<span>Sending…</span><svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';
      btn.disabled = true;
      btn.classList.add('opacity-60', 'cursor-not-allowed');
    });
  }

  // ── "Ask about …" links pre-fill the message box ───────────────────────
  var msg = document.getElementById('message');
  document.querySelectorAll('[data-topic]').forEach(function (link) {
    link.addEventListener('click', function () {
      if (!msg) return;
      var topic = link.getAttribute('data-topic');
      if (!msg.value.trim() || msg.dataset.prefilled === '1') {
        msg.value = "Hi, I'd like to know more about " + topic.toLowerCase() + '. ';
        msg.dataset.prefilled = '1';
      }
      setTimeout(function () { (document.getElementById('name') || msg).focus({ preventScroll: true }); }, 600);
    });
  });
  if (msg) msg.addEventListener('input', function () { msg.dataset.prefilled = '0'; });
  document.querySelectorAll('[data-topic]').forEach(function (l) { l.addEventListener('click', function () { document.querySelectorAll('[data-chip]').forEach(function (c) { c.setAttribute('aria-pressed', 'false'); }); }); });

  // ── Floating WhatsApp button: hidden while the hero, schedule band or
  //    contact section covers the middle of the screen (they have their own CTAs)
  var fab = document.getElementById('wa-fab');
  if (fab) {
    var fabZones = ['[aria-label="Welcome"]', '#schedule', '#contact']
      .map(function (sel) { return document.querySelector(sel); })
      .filter(Boolean);
    var fabTick = false;
    var updateFab = function () {
      fabTick = false;
      var mid = window.innerHeight / 2;
      var over = fabZones.some(function (el) {
        var r = el.getBoundingClientRect();
        return r.top < mid && r.bottom > mid;
      });
      fab.classList.toggle('is-hidden', over);
    };
    var queueFab = function () { if (!fabTick) { fabTick = true; requestAnimationFrame(updateFab); } };
    window.addEventListener('scroll', queueFab, { passive: true });
    window.addEventListener('resize', queueFab);
    updateFab();
  }

  // ── Programs: a photo follows the cursor over the list (desktop, fine pointer) ──
  // ── Programs: the photo panel follows the row being pointed at or focused
  var progFig = document.querySelector('.prog-figure');
  if (progFig) {
    var progImgs = progFig.querySelectorAll('.prog-img'), progCur = 0;
    var progName = progFig.querySelector('[data-prog-name]');
    var progTag = progFig.querySelector('[data-prog-tag]');
    var progRows = document.querySelectorAll('.reveal-row');
    var showProg = function (row) {
      progRows.forEach(function (r) { r.classList.toggle('is-active', r === row); });
      progName.textContent = row.querySelector('.reveal-name').textContent;
      progTag.textContent = row.getAttribute('data-tag');
      var src = row.getAttribute('data-img');
      if (progImgs[progCur].getAttribute('src') === src) return;
      var next = 1 - progCur;
      progImgs[next].src = src;
      progImgs[next].classList.add('is-on');
      progImgs[progCur].classList.remove('is-on');
      progCur = next;
    };
    progRows.forEach(function (row) {
      row.addEventListener('mouseenter', function () { showProg(row); });
      row.addEventListener('focus', function () { showProg(row); });
    });
    if (progRows[0]) progRows[0].classList.add('is-active');
  }

  // ── Contact: topic chips write the opening line of the message
  var chips = document.querySelectorAll('[data-chip]');
  chips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      chip.setAttribute('aria-pressed', chip.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
      if (!msg || (msg.value.trim() && msg.dataset.prefilled !== '1')) return;
      var picked = [];
      chips.forEach(function (c) { if (c.getAttribute('aria-pressed') === 'true') picked.push(c.getAttribute('data-chip').toLowerCase()); });
      if (!picked.length) { msg.value = ''; return; }
      var list = picked.length > 1 ? picked.slice(0, -1).join(', ') + ' and ' + picked[picked.length - 1] : picked[0];
      msg.value = "Hi, I'd like to know more about " + list + '. ';
      msg.dataset.prefilled = '1';
    });
  });

  // ── Class times: live status in Bhaktapur time (UTC+5:45)
  var live = document.querySelector('[data-live]');
  if (live) {
    var liveText = live.querySelector('[data-live-text]');
    var nowMark = document.querySelector('.dayline-now');
    var classes = [[360, 540, 'Morning class'], [1020, 1200, 'Evening class']];
    var clock = function (m) {
      var h = Math.floor(m / 60) % 24, mm = m % 60, ap = h < 12 ? 'am' : 'pm', h12 = h % 12 || 12;
      return h12 + (mm ? ':' + (mm < 10 ? '0' : '') + mm : '') + ap;
    };
    var span = function (d) {
      var h = Math.floor(d / 60), m = d % 60;
      return (h ? h + ' h ' : '') + (m || !h ? m + ' min' : '').trim();
    };
    var tickLive = function () {
      var d = new Date();
      var m = (d.getUTCHours() * 60 + d.getUTCMinutes() + 345) % 1440;
      var text = '', on = false;
      classes.forEach(function (c) {
        if (m >= c[0] && m < c[1]) { on = true; text = c[2] + ' is on now, until ' + clock(c[1]) + '.'; }
      });
      if (!on) {
        var next = classes.filter(function (c) { return c[0] > m; })[0];
        text = next
          ? 'Next class today at ' + clock(next[0]) + ', in ' + span(next[0] - m).trim() + '.'
          : 'Next class tomorrow at ' + clock(classes[0][0]) + '.';
      }
      liveText.textContent = text + ' It is ' + clock(m) + ' in Bhaktapur.';
      live.classList.toggle('is-live', on);
      live.hidden = false;
      if (nowMark) {
        var inDay = m >= 240 && m <= 1320;
        nowMark.hidden = !inDay;
        if (inDay) nowMark.style.left = ((m - 240) / 1080 * 100).toFixed(2) + '%';
      }
    };
    tickLive();
    setInterval(tickLive, 30000);
  }

  // ── Smooth scroll for anchor links ────────────────────────────────────
  document.querySelectorAll('a[href^="#"]').forEach(function (anchor) {
    anchor.addEventListener('click', function (e) {
      var href = this.getAttribute('href');
      if (href === '#') return;
      var target = document.querySelector(href);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
})();
</script>

