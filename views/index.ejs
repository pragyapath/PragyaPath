<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="overflow-x-hidden">
<%
  // Shared bits for this page
  const waLink = 'https://wa.me/9779828589863?text=' + encodeURIComponent("Namaste! I'd like to know more about classes at Pragya Path.");
  const waIcon = '<svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>';
  // Line-drawn lotus used as a small brass ornament
  const lotus = '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"><path d="M16 6c3 3.5 3 9.5 0 14-3-4.5-3-10.5 0-14z"/><path d="M16 20c-2.5-4-6.5-6.5-11-6.5 1 5 5 7.5 11 6.5z"/><path d="M16 20c2.5-4 6.5-6.5 11-6.5-1 5-5 7.5-11 6.5z"/><path d="M6 24h20"/></svg>';
  // Newsroom stays hidden until there are real articles to link to
  const showNewsroom = false;
%>

<!-- ═══════════════════════════════════════════════
     HERO
════════════════════════════════════════════════ -->
<section class="relative bg-paper overflow-hidden" aria-label="Welcome">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 md:px-12 pt-28 md:pt-36 pb-10 md:pb-14">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

      <div class="lg:col-span-7">
        <p class="hero-reveal hero-deva mb-5" lang="ne">प्रज्ञा पथ</p>

        <h1 class="hero-title hero-reveal d1">
          <span>Awaken<i>.</i></span>
          <span>Heal<i>.</i></span>
          <span>Transform<i>.</i></span>
        </h1>

        <p class="hero-reveal d2 text-muted text-lg md:text-xl leading-relaxed max-w-xl mt-7 mb-9">
          Hatha yoga and sound healing in a quiet studio in old Bhaktapur. Come as you are — beginners are always welcome.
        </p>

        <div class="hero-reveal d3 flex flex-col sm:flex-row gap-3 sm:gap-4">
          <a href="#schedule" class="btn-primary">See class times</a>
          <a href="<%= waLink %>" target="_blank" rel="noopener noreferrer" class="btn-quiet"><%- waIcon %>Message us on WhatsApp</a>
        </div>
      </div>

      <div class="lg:col-span-5 hero-reveal d2 pr-3 lg:pr-0">
        <div class="framed arch hero-photo max-w-md mx-auto lg:ml-auto">
          <img
            src="/images/hero.webp"
            alt="A teacher seated in meditation in the Pragya Path studio"
            class="aspect-[4/5] object-cover object-[72%_center]"
            fetchpriority="high"
          >
        </div>
      </div>
    </div>

    <dl class="hero-facts hero-reveal d4 mt-14 md:mt-16">
      <div><dt>Morning class</dt><dd>6 – 9 am</dd></div>
      <div><dt>Evening class</dt><dd>5 – 8 pm</dd></div>
      <div><dt>Studio</dt><dd>Dattatraye, Bhaktapur</dd></div>
    </dl>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     QUOTE
════════════════════════════════════════════════ -->
<section class="bg-paper py-20 md:py-32 px-5 sm:px-6 md:px-12" aria-label="Our approach">
  <figure class="max-w-4xl mx-auto text-center">
    <div class="brass-rule max-w-xs mx-auto mb-10" aria-hidden="true"><%- lotus %></div>
    <blockquote class="pull-quote">
      “Yoga is not just repetition of a few postures — it is the exploration and discovery of the subtle energies of life.”
    </blockquote>
    <figcaption class="mt-8 text-muted text-base">The idea every class at Pragya Path starts from</figcaption>
  </figure>
</section>


<!-- ═══════════════════════════════════════════════
     PROGRAMS
════════════════════════════════════════════════ -->
<section id="programs" class="py-20 md:py-32 px-5 sm:px-6 md:px-12 bg-ink relative overflow-hidden" aria-labelledby="programs-heading">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">

    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-28">
        <p class="deva-mark"><span class="deva" lang="ne">अभ्यास</span><span class="gloss">Practice</span></p>
        <h2 id="programs-heading" class="h-display">Practices for body, mind and soul</h2>
        <p class="lede mt-6">Drop in to a daily class, book a private session, or train to teach. Not sure which fits? Ask us and we'll suggest one.</p>

        <div class="framed arch hidden lg:block mt-12 max-w-sm">
          <img src="/images/sound-healing.webp" alt="Singing bowls laid out for a sound healing session" class="aspect-[4/5] object-cover" loading="lazy">
        </div>
      </div>
    </div>

    <% const primary = [
      { name: 'Regular yoga classes', desc: 'Daily Hatha Yoga to build strength, flexibility and inner stillness.', tag: 'Daily, all levels' },
      { name: 'Therapeutic yoga', desc: 'One-to-one sessions shaped around your body and health goals, with a guided diet plan.', tag: 'Private' },
      { name: 'Sound healing', desc: 'Tibetan singing bowls used to release tension and settle the nervous system.', tag: 'Relaxation' },
      { name: 'Singing bowl training', desc: 'Certified courses at levels 1, 2 and 3, from first strike to practitioner.', tag: 'Certificate course' },
      { name: 'Yoga teacher training', desc: 'Become a certified yoga teacher, grounded in traditional Hatha practice.', tag: 'Certificate course' },
      { name: 'Retreats & tours', desc: 'Multi-day retreats, spiritual tours and mindful hikes around the Kathmandu Valley.', tag: 'Multi-day' }
    ]; %>

    <div class="lg:col-span-7">
      <div class="program-list">
        <% primary.forEach(function(s) { %>
        <article class="program-row">
          <div>
            <span class="tag"><%= s.tag %></span>
            <h3><%= s.name %></h3>
            <p><%= s.desc %></p>
          </div>
          <a href="#contact" class="card-ask" data-topic="<%= s.name %>">Ask about this</a>
        </article>
        <% }) %>
      </div>

      <p class="mt-10 text-muted leading-relaxed">
        <span class="font-semibold text-stone">Also on offer:</span>
        <% const extras = ['Kids yoga', 'Corporate yoga', 'Yogic Zumba', 'Mindfulness hikes', 'Spiritual tours']; %>
        <% extras.forEach(function(name, i) { %><a href="#contact" data-topic="<%= name %>" class="link-line !p-0 !inline"><%= name %></a><%= i < extras.length - 1 ? ', ' : '.' %> <% }) %>
      </p>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     SCHEDULE BAND
════════════════════════════════════════════════ -->
<section id="schedule" class="band px-5 sm:px-6 md:px-12 py-20 md:py-32" aria-labelledby="schedule-heading">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16">
      <div>
        <p class="deva-mark"><span class="deva" lang="ne">समय</span><span class="gloss">Class times</span></p>
        <h2 id="schedule-heading" class="h-display">Every day, twice a day</h2>
      </div>
      <p class="lede md:text-right md:max-w-sm">Same times all week, including weekends and holidays.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 border-t border-line">
      <div class="pt-8 pb-10 md:py-12 md:pr-10">
        <p class="schedule-label mb-4">Morning</p>
        <p class="schedule-time">6–9<small>am</small></p>
      </div>
      <div class="pt-8 pb-10 md:py-12 md:pl-12 border-t md:border-t-0 md:border-l border-line">
        <p class="schedule-label mb-4">Evening</p>
        <p class="schedule-time">5–8<small>pm</small></p>
      </div>
    </div>

    <div class="pt-10 border-t border-line flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
      <p class="text-muted text-lg max-w-xl leading-relaxed">Drop in for a single class or ask about weekly and monthly passes. Message us before your first visit so we can save you a mat.</p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="<%= waLink %>" target="_blank" rel="noopener noreferrer" class="btn-primary"><%- waIcon %>Book on WhatsApp</a>
        <a href="#contact" class="btn-quiet">Send a message</a>
      </div>
    </div>
  </div>
</section>

<!--
     HIKING & NATURE RETREATS
-->
<section id="hiking" class="py-20 md:py-32 px-5 sm:px-6 md:px-12 bg-paper relative overflow-hidden" aria-labelledby="hiking-heading">

  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center relative z-10">

    <!-- Content -->
    <div>
      <p class="deva-mark"><span class="deva" lang="ne">यात्रा</span><span class="gloss">Journeys</span></p>

      <h2 id="hiking-heading" class="h-display mb-8">
        Mindful walks in the hills
      </h2>

      <div class="prose-body text-muted text-lg">
        <p>
          Beyond the mat and the singing bowls, healing also happens outdoors. Our guided hikes take you into the hills around the Kathmandu Valley.
        </p>
        <p>
          Walk slowly, meditate in the open air and take in the Himalayan views. Each hike is paced so you return grounded and clear-headed, not tired.
        </p>
      </div>
      <ul class="hike-list mt-8">
        <li>Mindful walking at an unhurried pace</li>
        <li>Meditation in the open air</li>
        <li>Himalayan viewpoints above the valley</li>
      </ul>
      <div class="mt-10">
        <a href="#contact" data-topic="Mindfulness hikes" class="btn-primary">Ask about the next hike</a>
      </div>
    </div>

    <!-- Illustration: Himalayan ridges at dusk, in the site palette -->
    <div class="relative pr-3 lg:pr-0">
      <figure class="framed">
        <svg class="hike-scene block w-full h-auto" viewBox="0 0 600 640" role="img" aria-labelledby="hike-scene-title">
          <title id="hike-scene-title">Illustration of Himalayan ridges at dusk with prayer flags and a walking path</title>
          <defs>
            <linearGradient id="hs-sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#11142B"/>
              <stop offset=".3" stop-color="#25264A"/>
              <stop offset=".48" stop-color="#6A4A62"/>
              <stop offset=".6" stop-color="#D08A5E"/>
              <stop offset=".7" stop-color="#EDB57A"/>
            </linearGradient>
            <radialGradient id="hs-sun" cx=".5" cy=".5" r=".5">
              <stop offset="0" stop-color="#F6D9A6"/>
              <stop offset=".6" stop-color="#E8A266"/>
              <stop offset="1" stop-color="#E8823A" stop-opacity="0"/>
            </radialGradient>
            <linearGradient id="hs-snow" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#F3E7D4"/>
              <stop offset="1" stop-color="#C9A55E" stop-opacity=".35"/>
            </linearGradient>
          </defs>

          <rect width="600" height="640" fill="url(#hs-sky)"/>

          <!-- stars -->
          <g fill="#F3E7D4" class="hs-stars">
            <circle cx="70" cy="60" r="1.2"/><circle cx="140" cy="110" r=".9"/><circle cx="230" cy="48" r="1.1"/>
            <circle cx="380" cy="80" r=".9"/><circle cx="470" cy="40" r="1.3"/><circle cx="540" cy="120" r=".8"/>
            <circle cx="300" cy="140" r=".7"/><circle cx="40" cy="170" r=".8"/>
          </g>

          <!-- setting sun -->
          <circle cx="252" cy="300" r="130" fill="url(#hs-sun)" opacity=".6"/>
          <circle cx="252" cy="300" r="38" fill="#F6D9A6"/>

          <!-- drifting cloud bands -->
          <g class="hs-cloud" fill="#F6D9A6" opacity=".22">
            <rect x="-40" y="236" width="240" height="3" rx="1.5"/><rect x="40" y="246" width="150" height="2" rx="1"/>
            <rect x="330" y="196" width="200" height="3" rx="1.5"/>
          </g>

          <!-- far snow peaks -->
          <path d="M0 400 L70 330 L110 352 L170 262 L215 318 L250 296 L320 214 L372 290 L410 268 L470 330 L520 300 L600 360 L600 640 L0 640Z" fill="#6E6A8A"/>
          <path d="M170 262 L194 292 L172 284 L156 292Z M320 214 L348 254 L322 244 L292 256Z M520 300 L544 322 L520 314 L500 324Z" fill="url(#hs-snow)"/>

          <!-- mid ridge -->
          <path d="M0 450 C80 410 130 430 190 400 C250 372 300 410 360 392 C430 370 500 410 600 384 L600 640 L0 640Z" fill="#3A3358"/>

          <!-- prayer flags strung across the mid ridge -->
          <path d="M60 430 Q200 470 330 418" fill="none" stroke="#C9A55E" stroke-width="1" opacity=".8"/>
          <g class="hs-flags">
            <path d="M84 440 l10 2 -2 14 -10 -2Z" fill="#E8823A"/>
            <path d="M112 449 l10 2 -1 14 -10 -1Z" fill="#F3E7D4"/>
            <path d="M141 455 l10 1 -1 14 -10 -1Z" fill="#C9A55E"/>
            <path d="M171 458 l10 0 0 14 -10 0Z" fill="#B4501A"/>
            <path d="M201 458 l10 -1 1 14 -10 1Z" fill="#E8823A"/>
            <path d="M231 455 l10 -2 2 14 -10 2Z" fill="#F3E7D4"/>
            <path d="M261 448 l10 -2 2 14 -10 2Z" fill="#C9A55E"/>
            <path d="M291 438 l10 -3 3 13 -10 3Z" fill="#B4501A"/>
          </g>

          <!-- near hill with the walking path -->
          <path d="M0 520 C120 480 220 500 300 470 C390 438 480 470 600 450 L600 640 L0 640Z" fill="#1B1F3F"/>
          <path d="M600 470 C520 490 470 520 400 530 C330 540 300 570 240 590 C200 604 170 620 150 640" fill="none" stroke="#C9A55E" stroke-width="1.4" stroke-dasharray="2 7" stroke-linecap="round" opacity=".85"/>

          <!-- small stupa on the far right hill -->
          <g transform="translate(470 452)" fill="#11142B">
            <rect x="-14" y="-4" width="28" height="6"/>
            <path d="M-11 -4 A11 11 0 0 1 11 -4Z"/>
            <rect x="-3" y="-24" width="6" height="10"/>
            <path d="M0 -36 L4 -24 L-4 -24Z"/>
          </g>

          <!-- foreground -->
          <path d="M0 590 C140 560 260 600 380 580 C470 566 540 590 600 580 L600 640 L0 640Z" fill="#11142B"/>
        </svg>
      </figure>
    </div>

  </div>
</section>



<!-- ═══════════════════════════════════════════════
     KALANIL ART GALLERY
════════════════════════════════════════════════ -->
<section id="art-gallery" class="py-20 md:py-32 px-5 sm:px-6 md:px-12 bg-ink relative overflow-hidden" aria-labelledby="art-gallery-heading">

  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">
    <div class="lg:col-span-5">
      <p class="deva-mark"><span class="deva" lang="ne">कला</span><span class="gloss">Kalanil Art Gallery</span></p>
      <h2 id="art-gallery-heading" class="h-display">Where art meets wellness</h2>
      <p class="lede mt-6">Our sister gallery shares the studio. Join a drawing class, or take home a painting made in Bhaktapur.</p>

      <div class="mt-10 pt-6 border-t border-line">
        <h3 class="font-serif text-2xl font-medium text-stone">Paintings for sale</h3>
        <p class="mt-3 text-muted leading-relaxed">Oil and acrylic, watercolour, mixed media, and portraits painted to order.</p>
        <a href="#contact" data-topic="Paintings for sale" class="card-ask mt-3">Ask for photos and prices</a>
      </div>
    </div>

    <div class="lg:col-span-7">
      <% const artClasses = [
        { name: 'Regular drawing classes', desc: 'Steady weekly practice to build drawing skills from the ground up.', tag: 'Ongoing' },
        { name: 'Special drawing workshops', desc: 'Focused sessions on one technique or medium at a time.', tag: 'Workshop' },
        { name: 'Saturday drawing classes', desc: 'A weekend class for anyone who works through the week.', tag: 'Saturdays' }
      ]; %>
      <div class="program-list">
        <% artClasses.forEach(function(c) { %>
        <article class="program-row">
          <div>
            <span class="tag"><%= c.tag %></span>
            <h3><%= c.name %></h3>
            <p><%= c.desc %></p>
          </div>
          <a href="#contact" class="card-ask" data-topic="<%= c.name %>">Book a place</a>
        </article>
        <% }) %>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     GRATITUDE
════════════════════════════════════════════════ -->
<section id="gratitude" class="bg-surface py-20 md:py-32 px-5 sm:px-6 md:px-12 overflow-hidden" aria-labelledby="gratitude-heading">

  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-24 items-center">

    <div class="order-2 lg:order-1 pr-3 lg:pr-0">
      <div class="framed">
        <img
          src="/images/loard-shive.webp"
          alt="Statue of Lord Shiva as Adiyogi, the first yogi"
          class="aspect-[4/5] object-cover"
          loading="lazy"
        >
      </div>
    </div>

    <div class="order-1 lg:order-2">
      <p class="deva-mark"><span class="deva" lang="ne">गुरु</span><span class="gloss">Gratitude</span></p>
      <h2 id="gratitude-heading" class="h-display mb-8">
        Honouring our gurus
      </h2>
      <div class="prose-body text-lg">
        <p>
          We bow in gratitude to Lord Shiva, the Adiyogi, whose teachings of yoga and meditation are the foundation of all our practice.
        </p>
        <p>
          Our guidance comes from a lineage of gurus who kept these traditions alive. Through their blessings we can share authentic practice with you.
        </p>
        <p class="text-stone font-medium">
          Every class, every session, every healing sound is an offering rooted in this wisdom.
        </p>
      </div>

      <p class="mt-10 font-deva text-3xl text-bronze" lang="sa">ॐ नमः शिवाय</p>
      <p class="mt-1 text-sm text-muted">Om Namah Shivaya</p>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════
     ABOUT
════════════════════════════════════════════════ -->
<section id="about" class="py-20 md:py-32 px-5 sm:px-6 md:px-12 bg-paper relative overflow-hidden" aria-labelledby="about-heading">

  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-20 items-center">

    <div class="lg:col-span-5 order-2 lg:order-1 relative pr-3 lg:pr-0">
      <div class="framed arch max-w-md mx-auto lg:mx-0">
        <img
          src="/images/girl-with-tibetean-bowl.webp"
          alt="A student playing a Tibetan singing bowl in the studio"
          class="aspect-[4/5] object-cover"
          loading="lazy"
        >
      </div>
      <img
        src="/images/tibetansingingbowl.webp"
        alt=""
        class="absolute -bottom-8 right-0 lg:-right-10 w-40 md:w-52 h-auto drop-shadow-[0_24px_28px_rgba(27,31,63,0.25)] pointer-events-none"
        loading="lazy"
      >
    </div>

    <div class="lg:col-span-7 order-1 lg:order-2">
      <p class="deva-mark"><span class="deva" lang="ne">हाम्रो कथा</span><span class="gloss">Our story</span></p>
      <h2 id="about-heading" class="h-display mb-8">
        A sanctuary for inner growth
      </h2>
      <div class="prose-body text-muted text-lg">
        <p>
          Pragya Path was founded in the old city of Bhaktapur with one intention: to offer a genuine space where people can slow down, breathe, and reconnect with themselves.
        </p>
        <p>
          We draw on the deep roots of Hatha Yoga and the meditative tradition of sound healing, and teach them in a way that fits modern life.
        </p>
        <p class="text-stone font-medium">
          Whether you are a complete beginner or an experienced practitioner, you are welcome here.
        </p>
      </div>
    </div>

  </div>

  <!-- Team -->
  <div class="max-w-7xl mx-auto mt-24 md:mt-32">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-20">
      <div class="lg:col-span-5">
        <h3 class="h-section text-3xl md:text-4xl">The people behind Pragya Path</h3>
      </div>
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-10">
        <div class="team-card">
          <div class="team-avatar"><span>AD</span></div>
          <h4 class="font-serif text-2xl font-medium text-stone mb-1">Aarati Dhakal</h4>
          <p class="text-sm font-semibold text-bronze mb-3">Founder, Pragya Path</p>
          <p class="text-muted leading-relaxed">Dedicated to sharing authentic yoga and sound healing traditions with the world.</p>
        </div>
        <div class="team-card">
          <div class="team-avatar"><span>AB</span></div>
          <h4 class="font-serif text-2xl font-medium text-stone mb-1">Anil Basnet</h4>
          <p class="text-sm font-semibold text-bronze mb-3">Founder, Kalanil Art Gallery</p>
          <p class="text-muted leading-relaxed">Bringing art and creativity together with wellness and healing.</p>
        </div>
      </div>
    </div>

    <div class="mt-16 pt-10 border-t border-line">
      <h3 class="font-ui font-semibold text-stone mb-8">Our teachers</h3>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6">
        <% const trainers = [
          { name: 'Aarati Dhakal', initials: 'AD' },
          { name: 'Sumon Acharya', initials: 'SA' },
          { name: 'Ramash Kadel', initials: 'RK' },
          { name: 'Meena K. Raut', initials: 'MR' },
          { name: 'Kalpana Gajmer', initials: 'KG' }
        ]; %>
        <% trainers.forEach(function(t) { %>
        <div class="team-card-sm">
          <div class="team-avatar-sm"><span><%= t.initials %></span></div>
