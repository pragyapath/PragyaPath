<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="overflow-x-hidden">
<%
  // Shared bits for this page
  const waLink = 'https://wa.me/9779828589863?text=' + encodeURIComponent("Namaste! I'd like to know more about classes at Pragya Path.");
  const waIcon = '<svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>';
  // Line-drawn lotus used as a small brass ornament
  const lotus = '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"><path d="M16 6c3 3.5 3 9.5 0 14-3-4.5-3-10.5 0-14z"/><path d="M16 20c-2.5-4-6.5-6.5-11-6.5 1 5 5 7.5 11 6.5z"/><path d="M16 20c2.5-4 6.5-6.5 11-6.5-1 5-5 7.5-11 6.5z"/><path d="M6 24h20"/></svg>';
  // Newsroom stays hidden until there are real articles to link to
  const showNewsroom = false;
%>

<!-- ═══════════════════════════════════════════════
     HERO — type-led, with photographs set inside the headline
════════════════════════════════════════════════ -->
<section class="photo-hero" aria-label="Welcome">
  <img class="photo-hero-img" src="/images/hero.webp" alt="A teacher seated in meditation beside a singing bowl, mountains beyond the window" fetchpriority="high">

  <div class="photo-hero-inner">
    <div class="photo-hero-copy">
      <p class="photo-hero-deva hero-reveal" lang="ne">प्रज्ञा पथ</p>
      <h1 class="photo-hero-title hero-reveal d1">Awaken, heal<br>and transform<i>.</i></h1>
      <p class="photo-hero-intro hero-reveal d2">
        Traditional hatha yoga and sound healing in a quiet studio in old Bhaktapur. <em>Pragya Path</em> means “the path of wisdom”, and beginners are always welcome.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 mt-9 hero-reveal d3">
        <a href="#schedule" class="btn-primary">See class times</a>
        <a href="<%= waLink %>" target="_blank" rel="noopener noreferrer" class="photo-hero-ghost"><%- waIcon %>WhatsApp us</a>
      </div>
    </div>

    <div class="photo-hero-foot hero-reveal d4">
      <a href="#schedule">Classes every day, 6–9am and 5–8pm</a>
      <span>Dattatraye, Bhaktapur, Nepal</span>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     QUOTE
════════════════════════════════════════════════ -->
<section class="bg-paper px-5 sm:px-6 md:px-12 py-24 md:py-40" aria-label="Our approach">
  <figure class="max-w-[88rem] mx-auto quote-grid">
    <span class="quote-mark" aria-hidden="true">“</span>
    <blockquote class="pull-quote">
      Yoga is not just repetition of a few postures — it is the exploration and discovery of the subtle energies of life.
    </blockquote>
    <figcaption class="quote-cap">The idea every class at Pragya Path starts from</figcaption>
  </figure>
</section>


<!-- ═══════════════════════════════════════════════
     PROGRAMS — large list; a photo follows the cursor on desktop
════════════════════════════════════════════════ -->
<section id="programs" class="bg-ink px-5 sm:px-6 md:px-12 py-24 md:py-36" aria-labelledby="programs-heading">
  <div class="max-w-[88rem] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 items-end mb-12 md:mb-20">
      <h2 id="programs-heading" class="h-display md:col-span-7">Six ways to practise with us</h2>
      <p class="lede md:col-span-4 md:col-start-9">Drop in to a daily class, book a private session, or train to teach. Not sure which fits? Ask, and we'll suggest one.</p>
    </div>

    <% const primary = [
      { name: 'Regular yoga classes', desc: 'Daily hatha yoga to build strength, flexibility and inner stillness.', tag: 'Daily, all levels', img: '/images/gallery/yoda-session-sm.webp' },
      { name: 'Therapeutic yoga', desc: 'One-to-one sessions shaped around your body and health goals, with a guided diet plan.', tag: 'Private', img: '/images/girl-with-tibetean-bowl.webp' },
      { name: 'Sound healing', desc: 'Tibetan singing bowls used to release tension and settle the nervous system.', tag: 'Relaxation', img: '/images/gallery/sound-healing-glimp-sm.webp' },
      { name: 'Singing bowl training', desc: 'Certified courses at levels 1, 2 and 3, from first strike to practitioner.', tag: 'Certificate', img: '/images/gallery/healing-sound-sm.webp' },
      { name: 'Yoga teacher training', desc: 'Become a certified yoga teacher, grounded in traditional hatha practice.', tag: 'Certificate', img: '/images/gallery/yoga-traning-sm.webp' },
      { name: 'Retreats & tours', desc: 'Multi-day retreats, spiritual tours and mindful hikes around the Kathmandu Valley.', tag: 'Multi-day', img: '/images/gallery/group-photo-with-guest-sm.webp' }
    ]; %>

    <div class="prog-layout">
    <ul class="reveal-list" role="list">
      <% primary.forEach(function(s) { %>
      <li>
        <a href="#contact" class="reveal-row" data-topic="<%= s.name %>" data-img="<%= s.img %>" data-tag="<%= s.tag %>">
          <img class="reveal-thumb" src="<%= s.img %>" alt="" loading="lazy">
          <span class="reveal-name"><%= s.name %></span>
          <span class="reveal-desc"><%= s.desc %></span>
          <span class="reveal-tag"><%= s.tag %></span>
          <span class="reveal-go" aria-hidden="true">Ask</span>
        </a>
      </li>
      <% }) %>
    </ul>
    <figure class="prog-figure" aria-hidden="true">
      <div class="prog-frame">
        <img class="prog-img is-on" src="<%= primary[0].img %>" alt="">
        <img class="prog-img" alt="">
      </div>
      <figcaption class="prog-cap"><span data-prog-name><%= primary[0].name %></span><span data-prog-tag><%= primary[0].tag %></span></figcaption>
    </figure>
    </div>

    <p class="mt-10 text-muted leading-relaxed max-w-3xl">
      <span class="font-semibold text-stone">Also on offer:</span>
      <% const extras = ['Kids yoga', 'Corporate yoga', 'Yogic Zumba', 'Mindfulness hikes', 'Spiritual tours']; %>
      <% extras.forEach(function(name, i) { %><a href="#contact" data-topic="<%= name %>" class="link-line !p-0 !inline"><%= name %></a><%= i < extras.length - 1 ? ', ' : '.' %> <% }) %>
    </p>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     CLASS TIMES — the day drawn as a line
════════════════════════════════════════════════ -->
<section id="schedule" class="band px-5 sm:px-6 md:px-12 py-24 md:py-36" aria-labelledby="schedule-heading">
  <div class="max-w-[88rem] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-10">

    <div class="lg:col-span-4">
      <h2 id="schedule-heading" class="h-display">Every day, twice a day</h2>
      <p class="lede mt-6">Same times all week, including weekends. Drop in for one class or ask about weekly and monthly passes — message us first and we'll keep a mat for you.</p>
      <div class="mt-9 flex flex-col sm:flex-row lg:flex-col xl:flex-row gap-3">
        <a href="<%= waLink %>" target="_blank" rel="noopener noreferrer" class="btn-primary"><%- waIcon %>Book on WhatsApp</a>
        <a href="#contact" class="btn-quiet">Send a message</a>
      </div>
    </div>

    <div class="lg:col-span-7 lg:col-start-6">
      <div class="grid grid-cols-2 gap-6">
        <div>
          <p class="schedule-label">Morning</p>
          <p class="schedule-time">6–9<small>am</small></p>
        </div>
        <div>
          <p class="schedule-label">Evening</p>
          <p class="schedule-time">5–8<small>pm</small></p>
        </div>
      </div>

      <p class="live-status" data-live hidden><span class="live-dot" aria-hidden="true"></span><span data-live-text></span></p>

      <!-- The day from 4am to 10pm, with the two class blocks marked -->
      <div class="dayline mt-12" role="img" aria-label="Classes run from 6 to 9 in the morning and 5 to 8 in the evening">
        <div class="dayline-track">
          <span class="dayline-block" style="left: 11.11%; width: 16.67%;"></span>
          <span class="dayline-block" style="left: 72.22%; width: 16.67%;"></span>
          <span class="dayline-now" hidden></span>
        </div>
        <div class="dayline-ticks" aria-hidden="true">
          <span style="left: 0%">4am</span>
          <span style="left: 22.22%">8am</span>
          <span style="left: 44.44%">noon</span>
          <span style="left: 66.67%">4pm</span>
          <span style="left: 88.89%">8pm</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     HIKING — wide heading, illustration leads, notes to the side
════════════════════════════════════════════════ -->
<section id="hiking" class="bg-paper px-5 sm:px-6 md:px-12 py-24 md:py-36 overflow-hidden" aria-labelledby="hiking-heading">
  <div class="max-w-[88rem] mx-auto">
    <p class="deva-mark"><span class="deva" lang="ne">यात्रा</span><span class="gloss">Journeys</span></p>
    <h2 id="hiking-heading" class="walk-title">Mindful walks<br>in the hills</h2>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 mt-12 md:mt-16 items-end">
      <div class="lg:col-span-7">
      <figure class="walk-figure">
        <svg class="hike-scene block w-full h-auto" viewBox="0 0 600 640" role="img" aria-labelledby="hike-scene-title">
          <title id="hike-scene-title">Illustration of a walker on a path through terraced hills below snowy Himalayan peaks, with prayer flags and a small stupa</title>
          <defs>
            <linearGradient id="hs-sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" class="hs-sky-1"/>
              <stop offset=".35" class="hs-sky-2"/>
              <stop offset=".55" class="hs-sky-3"/>
              <stop offset=".68" class="hs-sky-4"/>
            </linearGradient>
            <radialGradient id="hs-glow" cx=".5" cy=".5" r=".5">
              <stop offset="0" class="hs-glow-a"/>
              <stop offset="1" class="hs-glow-b"/>
            </radialGradient>
            <linearGradient id="hs-haze" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" class="hs-haze-a"/>
              <stop offset="1" class="hs-haze-b"/>
            </linearGradient>
            <filter id="hs-soft" x="-20%" y="-50%" width="140%" height="200%"><feGaussianBlur stdDeviation="6"/></filter>
          </defs>

          <rect width="600" height="640" fill="url(#hs-sky)"/>

          <!-- stars (dark mode only) -->
          <g class="hs-stars">
            <circle cx="70" cy="60" r="1.2"/><circle cx="140" cy="110" r=".9"/><circle cx="230" cy="48" r="1.1"/>
            <circle cx="380" cy="80" r=".9"/><circle cx="470" cy="40" r="1.3"/><circle cx="540" cy="120" r=".8"/>
            <circle cx="300" cy="140" r=".7"/><circle cx="40" cy="170" r=".8"/>
          </g>

          <!-- sun with a soft glow, resting between the peaks -->
          <circle cx="252" cy="292" r="140" fill="url(#hs-glow)"/>
          <circle class="hs-sun" cx="252" cy="292" r="40"/>

          <!-- soft clouds -->
          <g class="hs-cloud" filter="url(#hs-soft)">
            <ellipse cx="110" cy="208" rx="90" ry="12"/>
            <ellipse cx="160" cy="222" rx="60" ry="8"/>
            <ellipse cx="470" cy="168" rx="80" ry="10"/>
          </g>

          <!-- birds (light mode) -->
          <g class="hs-birds" fill="none" stroke-width="1.6" stroke-linecap="round">
            <path d="M398 120 q6 -6 12 0 q6 -6 12 0"/>
            <path d="M436 104 q4 -4 8 0 q4 -4 8 0"/>
          </g>

          <!-- farthest range -->
          <path class="hs-far" d="M0 372 L50 330 L90 344 L140 300 L190 330 L230 312 L280 276 L330 310 L380 286 L440 320 L500 292 L560 318 L600 300 L600 640 L0 640Z"/>

          <!-- main snow peaks -->
          <path class="hs-peak" d="M0 410 L70 340 L110 360 L170 262 L215 322 L250 300 L320 210 L372 292 L410 270 L470 334 L520 300 L600 360 L600 640 L0 640Z"/>
          <path class="hs-snow" d="M170 262 L188 291 L178 286 L170 296 L161 285 L152 292Z M320 210 L343 246 L332 240 L320 254 L308 238 L296 249Z M520 300 L536 318 L526 314 L518 322 L508 314Z"/>

          <!-- valley haze -->
          <rect y="350" width="600" height="110" fill="url(#hs-haze)"/>

          <!-- mid ridge with rice terraces -->
          <path class="hs-mid" d="M0 450 C80 410 130 430 190 400 C250 372 300 410 360 392 C430 370 500 410 600 384 L600 640 L0 640Z"/>
          <g class="hs-terrace" fill="none" stroke-width="1.2" stroke-linecap="round">
            <path d="M360 412 C420 396 480 420 560 404"/>
            <path d="M350 428 C420 412 490 436 580 420"/>
            <path d="M370 444 C430 430 500 452 590 438"/>
          </g>

          <!-- prayer flags strung across the mid ridge -->
          <path class="hs-string" d="M60 430 Q200 470 330 418" fill="none" stroke-width="1"/>
          <g class="hs-flags">
            <path d="M84 440 l10 2 -2 14 -10 -2Z" fill="#3D6FB6"/>
            <path d="M112 449 l10 2 -1 14 -10 -1Z" fill="#F4F1EA"/>
            <path d="M141 455 l10 1 -1 14 -10 -1Z" fill="#C8402E"/>
            <path d="M171 458 l10 0 0 14 -10 0Z" fill="#3E8E5A"/>
            <path d="M201 458 l10 -1 1 14 -10 1Z" fill="#E9B83A"/>
            <path d="M231 455 l10 -2 2 14 -10 2Z" fill="#3D6FB6"/>
            <path d="M261 448 l10 -2 2 14 -10 2Z" fill="#F4F1EA"/>
            <path d="M291 438 l10 -3 3 13 -10 3Z" fill="#C8402E"/>
          </g>

          <!-- near hill with the walking path -->
          <path class="hs-near" d="M0 520 C120 480 220 500 300 470 C390 438 480 470 600 450 L600 640 L0 640Z"/>
          <path class="hs-path" d="M600 470 C520 490 470 520 400 530 C330 540 300 570 240 590 C200 604 170 620 150 640" fill="none" stroke-width="2" stroke-dasharray="2 8" stroke-linecap="round"/>

          <!-- small stupa on the right hill -->
          <g class="hs-stupa" transform="translate(470 452)">
            <rect x="-14" y="-4" width="28" height="6"/>
            <path d="M-11 -4 A11 11 0 0 1 11 -4Z"/>
            <rect x="-3" y="-24" width="6" height="10"/>
            <path d="M0 -36 L4 -24 L-4 -24Z"/>
          </g>

          <!-- a walker with a stick, partway up the path -->
          <g class="hs-walker" transform="translate(392 506)">
            <circle cx="0" cy="-22" r="3.4"/>
            <path d="M-3 -18 L3 -18 L4 -6 L1 -6 L0 2 L-2 2 L-2 -6 L-4 -6Z"/>
            <path d="M3 -15 L9 4" fill="none" stroke-width="1.4" stroke-linecap="round"/>
          </g>

          <!-- foreground -->
          <path class="hs-fore" d="M0 590 C140 560 260 600 380 580 C470 566 540 590 600 580 L600 640 L0 640Z"/>
        </svg>
      </figure>
      </div>

      <div class="lg:col-span-4 lg:col-start-9 lg:pb-4">
        <div class="prose-body text-muted text-lg">
          <p>Healing also happens outdoors. Our guided hikes take you into the hills around the Kathmandu Valley.</p>
          <p>We walk slowly, meditate in the open air and stop for the Himalayan views. Each hike is paced so you come back grounded, not tired.</p>
        </div>
        <ul class="hike-list mt-8">
          <li>Mindful walking at an unhurried pace</li>
          <li>Meditation in the open air</li>
          <li>Himalayan viewpoints above the valley</li>
        </ul>
        <div class="mt-10">
          <a href="#contact" data-topic="Mindfulness hikes" class="btn-primary">Ask about the next hike</a>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     KALANIL ART GALLERY — three classes set side by side
════════════════════════════════════════════════ -->
<section id="art-gallery" class="bg-ink px-5 sm:px-6 md:px-12 py-24 md:py-32" aria-labelledby="art-gallery-heading">
  <div class="max-w-[88rem] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 items-end">
      <h2 id="art-gallery-heading" class="h-display md:col-span-7">Drawing classes at Kalanil</h2>
      <p class="lede md:col-span-4 md:col-start-9">Kalanil Art Gallery, our sister gallery, shares the studio. Come and draw with us, or take home a painting made in Bhaktapur.</p>
    </div>

    <% const artClasses = [
      { name: 'Regular drawing classes', desc: 'Steady weekly practice to build drawing skills from the ground up.', when: 'Every week' },
      { name: 'Special workshops', desc: 'Focused sessions on one technique or medium at a time.', when: 'Announced monthly' },
      { name: 'Saturday classes', desc: 'A weekend class for anyone who works through the week.', when: 'Saturdays' }
    ]; %>
    <div class="art-cols mt-14 md:mt-20">
      <% artClasses.forEach(function(c) { %>
      <article>
        <p class="art-when"><%= c.when %></p>
        <h3><%= c.name %></h3>
        <p class="art-desc"><%= c.desc %></p>
        <a href="#contact" class="link-line" data-topic="<%= c.name %>">Book a place</a>
      </article>
      <% }) %>
    </div>

    <p class="art-sale">
      Paintings for sale: oil and acrylic, watercolour, mixed media, and portraits painted to order.
      <a href="#contact" data-topic="Paintings for sale" class="link-line !p-0 !inline">Ask for photos and prices</a>
    </p>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     GRATITUDE — one full-bleed image, the mantra set large
════════════════════════════════════════════════ -->
<section id="gratitude" class="guru-band" aria-labelledby="gratitude-heading">
  <img src="/images/loard-shive.webp" alt="Statue of Lord Shiva as Adiyogi, the first yogi" loading="lazy">
  <div class="guru-inner">
    <p class="guru-mantra" lang="sa">ॐ नमः शिवाय</p>
    <div class="guru-text">
      <h2 id="gratitude-heading">Honouring our gurus</h2>
      <p>We bow to Lord Shiva, the Adiyogi, and to the line of teachers who kept these practices alive. Every class and every healing sound here is an offering to them.</p>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     ABOUT — a long opening sentence, then photo and people
════════════════════════════════════════════════ -->
<section id="about" class="bg-paper px-5 sm:px-6 md:px-12 py-24 md:py-36 overflow-hidden" aria-labelledby="about-heading">
  <div class="max-w-[88rem] mx-auto">
    <h2 id="about-heading" class="sr-only">About Pragya Path</h2>
    <p class="about-lead">
      Pragya Path began in the old city of Bhaktapur with one intention: a genuine place to slow down, breathe and come back to yourself.
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-10 mt-16 md:mt-24">
      <div class="lg:col-span-5 relative pr-6 pb-6 lg:pr-0">
        <div class="framed arch max-w-md">
          <img src="/images/girl-with-tibetean-bowl.webp" alt="A student playing a Tibetan singing bowl in the studio" class="aspect-[4/5] object-cover" loading="lazy">
        </div>
        <img src="/images/tibetansingingbowl.webp" alt="" class="absolute bottom-0 right-0 lg:right-4 w-36 md:w-48 h-auto drop-shadow-[0_24px_28px_rgba(27,31,63,0.25)] pointer-events-none" loading="lazy">
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <div class="prose-body text-muted text-lg">
          <p>We teach Hatha Yoga and the meditative tradition of sound healing as they were taught to us, in a way that fits modern life.</p>
          <p>Whether you are a complete beginner or have practised for years, you are welcome here.</p>
        </div>

        <h3 class="people-title">The people you'll meet</h3>
        <% const people = [
          { name: 'Aarati Dhakal', role: 'Founder of Pragya Path, teacher' },
          { name: 'Anil Basnet', role: 'Founder of Kalanil Art Gallery' },
          { name: 'Sumon Acharya', role: 'Teacher' },
          { name: 'Ramash Kadel', role: 'Teacher' },
          { name: 'Meena K. Raut', role: 'Teacher' },
          { name: 'Kalpana Gajmer', role: 'Teacher' }
        ]; %>
        <ul class="people" role="list">
          <% people.forEach(function(p) { %>
          <li><span class="people-name"><%= p.name %></span><span class="people-role"><%= p.role %></span></li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     GALLERY
════════════════════════════════════════════════ -->
<section id="gallery" class="bg-ink px-5 sm:px-6 md:px-12 py-24 md:py-32" aria-labelledby="gallery-heading">
  <div class="max-w-[88rem] mx-auto">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10 md:mb-14">
      <div>
        <h2 id="gallery-heading" class="h-display">Inside the studio</h2>
        <p class="lede mt-5">Classes, sound baths, trainings and the people who come to them.</p>
      </div>
      <button id="view-all-btn" class="btn-outline self-start md:self-auto">See all 50 photos</button>
    </div>

    <div id="gallery-photos" class="mosaic">
      <div><img src="/images/gallery/sound-healing-group.webp" alt="A group sound healing session with singing bowls" loading="lazy"></div>
      <div><img src="/images/gallery/healing-sound-sm.webp" alt="A teacher playing a singing bowl over a student's head" loading="lazy"></div>
      <div><img src="/images/gallery/sound-healing-glimp-sm.webp" alt="Students resting during a sound bath" loading="lazy"></div>
      <div><img src="/images/gallery/yoda-session-sm.webp" alt="A yoga class in the studio" loading="lazy"></div>
