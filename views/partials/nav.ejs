<!-- NAV -->
<nav id="nav" aria-label="Main navigation"
     class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 text-stone">

  <div class="max-w-7xl mx-auto px-6 md:px-12 h-20 md:h-24 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" aria-label="Pragya Path — Home" class="flex items-center gap-3 group">
      <img src="/images/logo.png" alt="Pragya Path Logo" width="32" height="32" class="w-8 h-8 object-contain transition-transform duration-500 group-hover:scale-110 group-hover:rotate-6">
      <div>
        <div class="text-[17px] font-serif font-bold tracking-[0.15em] uppercase leading-none" id="nav-logo-name">Pragya Path</div>
        <div class="text-[9px] font-sans font-bold tracking-[0.25em] uppercase opacity-70 mt-1" id="nav-logo-sub">Bhaktapur, Nepal</div>
      </div>
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-10" role="list">
      <li><a href="#gratitude" class="nav-link">Gratitude</a></li>
      <li><a href="#about" class="nav-link">About</a></li>
      <li><a href="#programs" class="nav-link">Programs</a></li>
      <li><a href="#art-gallery" class="nav-link">Art Gallery</a></li>
      <li><a href="#gallery" class="nav-link">Gallery</a></li>
      <li><a href="#newsrooms" class="nav-link">Newsrooms</a></li>
      <li><a href="#contact" class="nav-link">Contact</a></li>
    </ul>

    <!-- Mobile toggle -->
    <button id="nav-toggle" aria-label="Open menu" aria-expanded="false"
            class="md:hidden w-8 h-8 flex flex-col justify-center gap-[5px] group">
      <span class="nav-bar block h-px w-full bg-current transition-all duration-300 origin-center"></span>
      <span class="nav-bar block h-px w-5 bg-current transition-all duration-300 ml-auto"></span>
    </button>
  </div>
</nav>

<!-- Mobile drawer -->
<div id="nav-drawer"
     class="fixed inset-0 z-40 bg-base/95 flex flex-col items-center justify-center
            opacity-0 pointer-events-none transition-all duration-500 backdrop-blur-3xl"
     role="dialog" aria-modal="true" aria-label="Navigation menu">

  <button id="nav-close" aria-label="Close menu"
          class="absolute top-6 right-6 p-2 rounded-full bg-line/30 text-stone hover:bg-gold hover:text-white transition-all duration-300 transform hover:scale-110">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>

  <nav class="flex flex-col items-center gap-8 w-full px-6" aria-label="Mobile links">
    <a href="/" class="drawer-link">Home</a>
    <a href="#gratitude" class="drawer-link">Gratitude</a>
    <a href="#about" class="drawer-link">About</a>
    <a href="#programs" class="drawer-link">Programs</a>
    <a href="#art-gallery" class="drawer-link">Art Gallery</a>
    <a href="#gallery" class="drawer-link">Gallery</a>
    <a href="#newsrooms" class="drawer-link">Newsrooms</a>
    <a href="#contact" class="drawer-link border-b-0">Contact</a>
  </nav>
</div>

<script>
(function () {
  const nav      = document.getElementById('nav');
  const toggle   = document.getElementById('nav-toggle');
  const drawer   = document.getElementById('nav-drawer');
  const closeBtn = document.getElementById('nav-close');
  const links    = document.querySelectorAll('.drawer-link');
  const navLinks = document.querySelectorAll('.nav-link');

  /* ── Scroll state ── */
  function onScroll() {
    if (window.scrollY > 40) {
      nav.classList.add('glass', 'shadow-lg', 'border-b', 'border-line/20');
      nav.classList.remove('bg-transparent', 'border-transparent');
    } else {
      nav.classList.remove('glass', 'shadow-lg', 'border-b', 'border-line/20');
      nav.classList.add('bg-transparent', 'border-transparent');
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  /* ── Active nav link on scroll ── */
  var sections = document.querySelectorAll('section[id]');
  function setActiveLink() {
    var scrollPos = window.scrollY + 200;
    sections.forEach(function (section) {
      var top = section.offsetTop;
      var height = section.offsetHeight;
      var id = section.getAttribute('id');
      if (scrollPos >= top && scrollPos < top + height) {
        navLinks.forEach(function (link) {
          link.classList.remove('active');
          if (link.getAttribute('href') === '#' + id) {
            link.classList.add('active');
          }
        });
      }
    });
  }
  window.addEventListener('scroll', setActiveLink, { passive: true });
  setActiveLink();

  /* ── Mobile drawer ── */
  function open() {
    drawer.classList.remove('opacity-0', 'pointer-events-none');
    drawer.classList.add('opacity-100');
    document.body.style.overflow = 'hidden';
    toggle.setAttribute('aria-expanded', 'true');
  }
  function close() {
    drawer.classList.add('opacity-0', 'pointer-events-none');
    drawer.classList.remove('opacity-100');
    document.body.style.overflow = '';
    toggle.setAttribute('aria-expanded', 'false');
  }

  toggle.addEventListener('click', open);
  closeBtn.addEventListener('click', close);
  links.forEach(function (l) { l.addEventListener('click', close); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
})();
</script>
