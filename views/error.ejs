<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="min-h-screen flex items-center justify-center px-5 sm:px-6 pt-32 pb-20 bg-paper">
  <div class="max-w-lg w-full text-center">
    <p class="deva-mark center justify-center"><span class="deva" lang="ne">माफ गर्नुहोस्</span><span class="gloss">Error <%= statusCode %></span></p>
    <h1 class="h-display mb-5"><%= statusCode === 404 ? 'Page not found' : 'Something went wrong' %></h1>
    <p class="lede mx-auto mb-10"><%= message %></p>

    <% if (locals.stack) { %>
    <pre class="text-left bg-surface border border-line p-6 text-[11px] font-mono text-muted overflow-auto max-h-40 mb-10"><%= stack %></pre>
    <% } %>

    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/" class="btn-primary">Go to the homepage</a>
      <a href="mailto:pragyapath1@gmail.com" class="btn-quiet">Email us</a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
