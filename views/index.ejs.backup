  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="mb-20 md:mb-28 max-w-2xl fade-up text-center mx-auto">
      <div class="inline-flex items-center justify-center gap-4 mb-6">
        <span class="w-12 h-px bg-gold/50"></span>
        <p class="text-[11px] font-sans font-bold uppercase tracking-widest3 text-gold">Yoga & Sound Healing Programs</p>
        <span class="w-12 h-px bg-gold/50"></span>
      </div>
      <h2 id="programs-heading" class="font-serif text-4xl md:text-5xl lg:text-6xl font-medium text-stone leading-tight">
        Practices for body, mind & soul
      </h2>
    </div>

    <!-- Primary services -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-10">

      <% const primary = [
        {
          num: '01',
          name: 'Regular Yoga Classes',
          desc: 'Daily Hatha Yoga sessions to build strength, flexibility, and inner stillness. Open to all levels.',
          tag: 'Daily · All Levels'
        },
        {
          num: '02',
          name: 'Therapeutic Yoga',
          desc: 'Personalised sessions designed around your body and health goals, paired with a guided diet plan.',
          tag: 'Personalised'
        },
        {
          num: '03',
          name: 'Sound Healing',
          desc: 'Gentle vibrational therapy using Tibetan singing bowls to release tension and restore harmony.',
          tag: 'Healing · Relaxation'
        },
        {
          num: '04',
          name: 'Singing Bowl Training',
          desc: 'Professional certification courses at Levels 1, 2, and 3 — from beginner to advanced practitioner.',
          tag: 'Certification L1–L3'
        },
        {
          num: '05',
          name: "Yoga Teacher's Training",
          desc: 'Comprehensive programmes to become a certified yoga instructor, grounded in authentic tradition.',
          tag: 'Certification'
        },
        {
          num: '06',
          name: 'Retreats & Tours',
          desc: 'Immersive yoga retreats, spiritual tours, and mindfulness hikes through the sacred landscapes of Nepal.',
          tag: 'Multi-day'
        }
      ] %>

      <% primary.forEach(function(s, i) { %>
      <article class="card group stagger-child">
        <!-- Decorative bg circle on hover -->
        <div class="absolute -right-20 -top-20 w-48 h-48 bg-gold/5 rounded-full blur-3xl group-hover:bg-gold/15 transition-colors duration-700 pointer-events-none"></div>
        
        <div class="flex items-start justify-between relative z-10">
          <span class="card-number"><%= s.num %></span>
          <span class="card-tag"><%= s.tag %></span>
        </div>
        <div class="flex-grow relative z-10">
          <h3 class="card-title"><%= s.name %></h3>
          <p class="card-desc"><%= s.desc %></p>
        </div>
        <div class="mt-auto pt-6 flex items-center gap-4 relative z-10">
          <span class="btn-ghost">
            Explore
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </span>
        </div>
      </article>
      <% }) %>
    </div>

    <!-- Secondary services row -->
    <div class="flex flex-wrap justify-center gap-4 mb-16">
      <% const secondary = ['Kids Yoga', 'Corporate Yoga', 'Yogic Zumba', 'Mindfulness Hikes', 'Spiritual Tours'] %>
      <% secondary.forEach(function(name) { %>
      <div class="bg-transparent rounded-full px-8 py-4 border border-line text-center hover:border-gold hover:bg-gold/5 group transition-all duration-500 cursor-default stagger-child">
        <span class="font-sans text-xs font-light text-muted group-hover:text-gold uppercase tracking-widest3 transition-colors duration-500"><%= name %></span>
      </div>
      <% }) %>
    </div>

    <!-- Available Time & Book Now -->
    <div class="max-w-4xl mx-auto fade-up">
      <div class="card group">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <!-- Schedule Info -->
          <div>
            <div class="inline-flex items-center gap-3 mb-4">
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span class="section-label">Available Time</span>
            </div>
            <div class="space-y-4">
              <div class="flex items-center gap-6 p-4 bg-ink/50 rounded-none border border-line/30">
                <div class="w-10 h-10 rounded-full bg-gold/10 flex items-center justify-center">
                  <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                  </svg>
                </div>
                <div>
                  <span class="font-serif text-xl text-stone">Morning</span>
                  <span class="font-sans text-base text-muted font-light ml-3">6:00 – 9:00 AM</span>
                </div>
              </div>
              <div class="flex items-center gap-6 p-4 bg-ink/50 rounded-none border border-line/30">
                <div class="w-10 h-10 rounded-full bg-gold/10 flex items-center justify-center">
                  <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                  </svg>
                </div>
                <div>
                  <span class="font-serif text-xl text-stone">Evening</span>
                  <span class="font-sans text-base text-muted font-light ml-3">5:00 – 8:00 PM</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Book Now Button -->
          <div class="flex flex-col items-start md:items-end gap-6">
            <p class="font-sans text-sm text-muted font-light">Ready to begin your journey?</p>
            <a href="#contact" class="btn-primary group">
              Book Now
              <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- 
     HIKING & NATURE RETREATS
-->
<section id="hiking" class="py-12 md:py-16 px-6 md:px-12 bg-ink relative border-b border-line overflow-hidden" aria-labelledby="hiking-heading">
  <!-- Decorative background elements -->
  <div class="absolute -right-40 -bottom-40 w-[40rem] h-[40rem] bg-sage/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center relative z-10">

    <!-- Content -->
    <div class="order-1 lg:order-1 fade-up relative z-20">
      <div class="flex items-center gap-4 mb-8">
        <span class="w-12 h-px bg-gold/50"></span>
        <p class="text-[11px] font-sans font-bold uppercase tracking-widest3 text-gold">Nature Retreats</p>
      </div>

      <h2 id="hiking-heading" class="font-serif text-4xl md:text-5xl lg:text-6xl font-medium text-stone leading-tight mb-10">
        Connect with <br><span class="italic text-gold">Nature</span>
      </h2>

      <div class="space-y-6 font-sans text-muted font-light leading-relaxed text-lg">
        <p>
          Beyond the mat and the singing bowls, true healing happens when we step outside. Our guided hiking retreats take you into the breathtaking hills surrounding the Kathmandu Valley.
        </p>
        <p>
          Experience mindful walking, outdoor meditation sessions, and breathtaking panoramic views of the Himalayas. These hikes are designed to ground your energy, clear your mind, and deepen your spiritual practice in the embrace of nature.
        </p>
      </div>

      <div class="mt-14 pt-10 border-t border-line flex flex-wrap gap-8">
        <div>
          <div class="font-serif text-4xl text-stone mb-2 flex items-center gap-2">
            <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Local
          </div>
          <div class="text-[10px] font-sans font-bold uppercase tracking-widest3 text-muted">Trails</div>
        </div>
        <div>
          <div class="font-serif text-4xl text-stone mb-2 flex items-center gap-2">
            <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            Morning
          </div>
          <div class="text-[10px] font-sans font-bold uppercase tracking-widest3 text-muted">Sessions</div>
        </div>
      </div>
      
      <div class="mt-12">
        <a href="#contact" class="btn-primary group">
          Join a Hike
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
      </div>
    </div>

    <!-- Interactive Mini-Game / Simulation -->
    <div class="relative fade-up delay-2 order-2 lg:order-2 group">
      <!-- Ambient glow backing -->
      <div class="absolute inset-0 bg-sage/20 rounded-none transform -rotate-3 scale-105"
           style="transition: transform 1.5s cubic-bezier(0.4, 0, 0.2, 1); will-change: transform;"
           data-parallax-backing></div>

      <!-- Canvas Container -->
      <div class="rounded-none shadow-2xl relative z-10 bg-ink border border-line/20 img-hover"
           style="transition: transform 1.5s cubic-bezier(0.4, 0, 0.2, 1); will-change: transform;"
           data-parallax-main>
        <canvas id="hiking-canvas" class="w-full aspect-[4/3] lg:aspect-square object-cover cursor-pointer touch-none"></canvas>
      </div>
    </div>
    </div>

  </div>
</section>

<!-- Hiking Interactive Script (Playable Mini-Game) -->
<script>
  (function() {
    const canvas = document.getElementById('hiking-canvas');
    if(!canvas) return;
    const ctx = canvas.getContext('2d');
    let w, h;
    
    // Game state
    let scrollX = 0;
    let targetScrollX = 0;
    
    // Physics / Jumping
    let hikerYOffset = 0;
    let hikerVY = 0;
    let isJumping = false;
    const gravity = 0.6;
    const jumpPower = -11;
    
    // Game mechanics
    let score = 0;
    let rocks = [];
    let nextRockX = 600;
    let gameState = 'playing'; // 'playing', 'hit'
    let hitTimer = 0;
    
    // Colors matching palette
    const COLOR_SKY = '#F4F9F9';
    const COLOR_SUN = '#EE7924';
    const COLOR_MOUNTAIN_FAR = '#8BD3DD';
    const COLOR_MOUNTAIN_MID = '#1A6A73';
    const COLOR_MOUNTAIN_NEAR = '#0F383D';
    
    function resize() {
      w = canvas.parentElement.clientWidth;
      h = canvas.parentElement.clientHeight;
      canvas.width = w * window.devicePixelRatio;
      canvas.height = h * window.devicePixelRatio;
      ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    }
    
    window.addEventListener('resize', resize);
    setTimeout(resize, 100);
    
    // Controls: Any click/tap makes the hiker jump
    const jump = (e) => {
      e.preventDefault(); 
      if(!isJumping) {
        isJumping = true;
        hikerVY = jumpPower;
        if(gameState === 'hit') gameState = 'playing';
      }
    };
    
    canvas.addEventListener('mousedown', jump);
    canvas.addEventListener('touchstart', jump, {passive: false});
    // Remove pointer-events from canvas temporarily if user wants to scroll past it, 
    // but the aspect ratio requires them to touch it. 
    // We only prevent default on the canvas itself, so scrolling outside works.
    
    // Terrain math (reused for drawing and collision)
    function getTerrainY(worldX, yBase, amplitude, frequency) {
      const noise = Math.sin(worldX * frequency) * amplitude 
                  + Math.cos(worldX * frequency * 2.5) * (amplitude * 0.3);
      return yBase - noise;
    }
    
    // Draw mountain layer
    function drawMountains(offset, yBase, amplitude, frequency, color) {
      ctx.fillStyle = color;
      ctx.beginPath();
      ctx.moveTo(0, h);
      for(let x = 0; x <= w; x += 10) {
        ctx.lineTo(x, getTerrainY(x + offset, yBase, amplitude, frequency));
      }
      ctx.lineTo(w, h);
      ctx.fill();
    }
    
    // Draw Hiker
    let stepCycle = 0;
    function drawHiker(x, baseY) {
      ctx.save();
      ctx.translate(x, baseY + hikerYOffset);
      
      // Stop walking animation if jumping or hit
      if(!isJumping && gameState !== 'hit') {
        stepCycle += 0.2;
      }
      
      const bob = isJumping ? -2 : Math.sin(stepCycle * 2) * 2;
      
      ctx.fillStyle = gameState === 'hit' ? '#FF5555' : COLOR_SUN;
      
      // Torso/Backpack
      ctx.beginPath();
      ctx.roundRect(-4, bob - 16, 8, 16, 3);
      ctx.fill();
      
      // Head
      ctx.beginPath();
      ctx.arc(0, bob - 24, 6, 0, Math.PI*2);
      ctx.fill();
      
      // Backpack detailing
      ctx.fillStyle = COLOR_MOUNTAIN_NEAR;
      ctx.beginPath();
      ctx.roundRect(-7, bob - 14, 5, 12, 2); 
      ctx.fill();
      
      // Legs
      ctx.strokeStyle = gameState === 'hit' ? '#FF5555' : COLOR_SUN;
      ctx.lineWidth = 3;
      ctx.lineCap = 'round';
      
      // Left leg
      ctx.beginPath();
      ctx.moveTo(-1, bob);
      ctx.lineTo(isJumping ? -4 : -2 + Math.sin(stepCycle) * 8, bob + 12);
      ctx.stroke();
      
      // Right leg
      ctx.beginPath();
      ctx.moveTo(2, bob);
      ctx.lineTo(isJumping ? 4 : 2 + Math.sin(stepCycle + Math.PI) * 8, bob + 12);
      ctx.stroke();
      
      // Hiking stick (hide if hit)
      if (gameState !== 'hit') {
        ctx.strokeStyle = COLOR_MOUNTAIN_NEAR;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(8, bob - 5);
        ctx.lineTo(12 + Math.sin(stepCycle + Math.PI) * 5, bob + 14);
        ctx.stroke();
      }
      
      ctx.restore();
    }
    
    // Draw obstacles (rocks)
    function drawRocks(terrainParams) {
      ctx.fillStyle = COLOR_MOUNTAIN_NEAR;
      for (let i = rocks.length - 1; i >= 0; i--) {
        const r = rocks[i];
        const screenX = r.x - scrollX;
        
        // Remove offscreen
        if (screenX < -50) {
          rocks.splice(i, 1);
          continue;
        }
        
        // Draw if on screen
        if (screenX < w + 50) {
          const terrainY = getTerrainY(r.x, ...terrainParams);
          
          ctx.beginPath();
          // Draw a jagged rock shape
          ctx.moveTo(screenX - 10, terrainY);
          ctx.lineTo(screenX - 5, terrainY - 15);
          ctx.lineTo(screenX + 5, terrainY - 18);
          ctx.lineTo(screenX + 12, terrainY - 10);
          ctx.lineTo(screenX + 15, terrainY);
          ctx.fill();
          
          // Collision Check
          const hikerScreenX = w / 2;
          if (!r.passed && screenX > hikerScreenX - 15 && screenX < hikerScreenX + 15) {
             // Hiker is over the rock X-wise. Check Y-wise.
             if (hikerYOffset > -15) { // Collided!
                gameState = 'hit';
                hitTimer = 30;
                score = Math.max(0, score - 5);
                r.passed = true;
             } else {
                // Successfully jumped over!
                score += 10;
                r.passed = true;
             }
          }
        }
      }
    }
    
    function loop() {
      // Auto run
      const speed = gameState === 'hit' ? 0.5 : 3.5;
      targetScrollX += speed;
      scrollX += (targetScrollX - scrollX) * 0.2;
      
      // Generate new rocks
      if (scrollX + w > nextRockX) {
        rocks.push({ x: nextRockX, passed: false });
        nextRockX += 300 + Math.random() * 400; // random gap between 300-700px
      }
      
      // Physics (Gravity & Jumping)
      if(isJumping) {
        hikerVY += gravity;
        hikerYOffset += hikerVY;
        if(hikerYOffset >= 0) {
          hikerYOffset = 0;
          hikerVY = 0;
          isJumping = false;
        }
      }
      
      // Hit flash logic
      if (hitTimer > 0) hitTimer--;
      if (hitTimer === 0 && gameState === 'hit') gameState = 'playing';
      
      // Background / Sky
      ctx.fillStyle = hitTimer > 0 && hitTimer % 4 < 2 ? '#FFDDDD' : COLOR_SKY;
      ctx.fillRect(0, 0, w, h);
      
      // Sun
      ctx.fillStyle = COLOR_SUN;
      ctx.beginPath();
      ctx.arc(w * 0.7 - (scrollX * 0.02), h * 0.25, w * 0.1, 0, Math.PI*2);
      ctx.fill();
      
      // Parallax Layers
      drawMountains(scrollX * 0.3, h * 0.45, h * 0.15, 0.004, COLOR_MOUNTAIN_FAR);
      drawMountains(scrollX * 0.6, h * 0.65, h * 0.12, 0.007, COLOR_MOUNTAIN_MID);
      
      // Foreground Layer Params
      const fgParams = [h * 0.85, h * 0.08, 0.012];
      drawMountains(scrollX, fgParams[0], fgParams[1], fgParams[2], COLOR_MOUNTAIN_NEAR);
      
      // Obstacles
      drawRocks(fgParams);
      
      // Get exact Y position of foreground at center of screen for the hiker to stand on
      const hikerTerrainY = getTerrainY(scrollX + w/2, fgParams[0], fgParams[1], fgParams[2]);
      drawHiker(w/2, hikerTerrainY);
      
      // UI / Text
      ctx.fillStyle = COLOR_MOUNTAIN_NEAR;
      ctx.font = '800 16px Montserrat, sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText(`Zen Points: ${score}`, 20, 30);
      
      ctx.fillStyle = COLOR_SKY;
      ctx.font = '600 12px Montserrat, sans-serif';
      ctx.textAlign = 'center';
      ctx.globalAlpha = 0.9;
      // letterSpacing hack for canvas
      const text = "TAP TO JUMP";
      ctx.fillText(text, w/2, h - 20);
      ctx.globalAlpha = 1.0;
      
      requestAnimationFrame(loop);
    }
    
    loop();
  })();
</script>


<!-- ═══════════════════════════════════════════════
     KALANIL ART GALLERY (Heart Chakra)
════════════════════════════════════════════════ -->
<section id="art-gallery" class="py-12 md:py-16 px-6 md:px-12 bg-surface relative overflow-hidden border-b border-line" aria-labelledby="art-gallery-heading">
  <!-- Decorative background -->
  <div class="absolute -right-40 -bottom-40 w-[40rem] h-[40rem] bg-gold/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">

    <!-- Header -->
    <div class="mb-16 md:mb-24 text-center max-w-2xl mx-auto fade-up">
      <div class="inline-flex items-center justify-center gap-4 mb-6">
        <span class="w-12 h-px bg-gold/50"></span>
        <p class="text-[11px] font-sans font-bold uppercase tracking-widest3 text-gold">Kalanil Art Gallery</p>
        <span class="w-12 h-px bg-gold/50"></span>
      </div>
      <h2 id="art-gallery-heading" class="font-serif text-4xl md:text-5xl lg:text-6xl font-medium text-stone leading-tight">
        Where art meets <span class="italic text-gold">wellness</span>
      </h2>
      <p class="mt-6 font-sans text-muted font-light text-lg">
        Express your creativity through art classes and discover unique paintings that inspire peace and transformation.
      </p>
    </div>

    <!-- Art Classes -->
    <div class="mb-20 fade-up">
      <div class="flex items-center gap-4 mb-10">
        <span class="w-12 h-px bg-gold/50"></span>
        <h3 class="font-serif text-2xl md:text-3xl font-medium text-stone">Art Classes</h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% const artClasses = [
          {
            name: 'Regular Drawing Classes',
            desc: 'Consistent practice sessions to build foundational drawing skills and artistic expression.',
            tag: 'Ongoing'
          },
          {
            name: 'Special Drawing Classes',
            desc: 'Focused workshops on specific techniques and advanced artistic methods.',
            tag: 'Workshop'
          },
          {
            name: 'Saturday Drawing Classes',
            desc: 'Weekend sessions perfect for those with busy schedules who want to explore art.',
            tag: 'Weekend'
          }
        ]; %>

        <% artClasses.forEach(function(c, i) { %>
        <div class="card group stagger-child">
          <div class="absolute -right-16 -top-16 w-32 h-32 bg-gold/5 rounded-full blur-2xl group-hover:bg-gold/15 transition-colors duration-700 pointer-events-none"></div>
          
          <div class="relative z-10">
            <span class="card-tag"><%= c.tag %></span>
          </div>
          <div class="flex-grow relative z-10">
            <h4 class="card-title text-2xl md:text-2xl"><%= c.name %></h4>
            <p class="card-desc text-base"><%= c.desc %></p>
          </div>
          <a href="#contact" class="mt-auto btn-ghost">
            Book Now
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
        <% }) %>
      </div>
    </div>

    <!-- Paintings on Sale -->
    <div class="fade-up">
      <div class="flex items-center gap-4 mb-10">
        <span class="w-12 h-px bg-gold/50"></span>
        <h3 class="font-serif text-2xl md:text-3xl font-medium text-stone">Paintings on Sale</h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <% const paintings = [
          { name: 'Oil / Acrylic Painting', medium: 'Oil & Acrylic' },
          { name: 'Water Colour Painting', medium: 'Water Colour' },
          { name: 'Portrait', medium: 'Oil / Acrylic / Water' },
          { name: 'Other Paintings', medium: 'Mixed Media' }
        ]; %>

        <% paintings.forEach(function(p, i) { %>
        <div class="bg-base border border-line p-6 flex flex-col items-center text-center group hover:border-gold transition-all duration-500">
          <!-- Painting placeholder -->
          <div class="w-full aspect-square bg-gradient-to-br from-sage/50 via-base to-surface border border-line/30 mb-6 flex items-center justify-center group-hover:border-gold/50 transition-colors duration-500 img-hover">
            <svg class="w-12 h-12 text-gold/30 group-hover:text-gold/60 transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <h4 class="font-serif text-lg font-medium text-stone group-hover:text-gold mb-2 transition-colors duration-500"><%= p.name %></h4>
          <p class="text-[10px] font-sans font-bold uppercase tracking-widest3 text-muted mb-4"><%= p.medium %></p>
          <a href="#contact" class="mt-auto inline-flex items-center gap-2 text-[11px] font-sans font-bold uppercase tracking-widest2 text-stone hover:text-gold transition-all duration-500 group/btn">
            Buy Now
            <svg class="w-3 h-3 transform group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
        <% }) %>
      </div>
    </div>

  </div>
</section>


<!-- ═══════════════════════════════════════════════
     ABOUT
════════════════════════════════════════════════ -->
<section id="about" class="py-12 md:py-16 px-6 md:px-12 bg-surface relative overflow-hidden border-b border-line" aria-labelledby="about-heading">
  <!-- Decorative background elements -->
  <div class="absolute -left-40 top-40 w-[40rem] h-[40rem] bg-gold/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center relative z-10">

    <!-- Images -->
    <div class="relative fade-up order-2 lg:order-1 group">
      <!-- Ambient glow backing -->
      <div class="absolute inset-0 bg-gold/10 rounded-none transform rotate-3 scale-105"
           style="transition: transform 1.5s cubic-bezier(0.4, 0, 0.2, 1); will-change: transform;"
           data-parallax-backing></div>

      <!-- Main Image — lift on hover, inner img scales via img-hover -->
      <div class="img-hover rounded-none shadow-2xl relative z-10"
           style="transition: transform 1.5s cubic-bezier(0.4, 0, 0.2, 1); will-change: transform;"
           data-parallax-main>
        <img
          src="/images/girl-with-tibetean-bowl.png"
          alt="Yoga practitioner in a peaceful pose"
          class="w-full aspect-[4/3] lg:aspect-square object-cover filter grayscale opacity-80"
          loading="lazy"
        >
      </div>

      <!-- Floating Singing Bowl PNG -->
      <div class="absolute -bottom-16 -right-10 md:-right-20 w-2/3 max-w-[300px] z-20 pointer-events-none img-hover-light"
           style="transition: transform 1.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.9s ease; will-change: transform;"
           data-parallax-float>
        <img
          src="/images/tibetansingingbowl.png"
          alt="Tibetan singing bowls"
          class="w-full h-auto object-contain filter grayscale opacity-80 drop-shadow-[0_20px_30px_rgba(0,0,0,0.5)]"
          style="transition: filter 1.2s cubic-bezier(0.4, 0, 0.2, 1), opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1), transform 1.5s cubic-bezier(0.4, 0, 0.2, 1); will-change: transform, filter;"
          loading="lazy"
        >
      </div>
    </div>

    <!-- Text -->
    <div class="order-1 lg:order-2 fade-up delay-2">
      <div class="inline-flex items-center gap-4 mb-6">
        <span class="text-[11px] font-sans font-bold uppercase tracking-widest3 text-gold">Our Story</span>
        <span class="w-16 h-px bg-gold/50"></span>
      </div>
      <h2 id="about-heading" class="font-serif text-4xl md:text-5xl lg:text-6xl font-medium text-stone leading-tight mb-10">
        A sanctuary for<br><span class="italic text-gold">inner growth</span>
      </h2>
      <div class="space-y-6 font-sans text-muted font-light leading-relaxed text-lg">
        <p>
          Nestled in the ancient city of Bhaktapur, Pragya Path was founded with a single intention —
          to offer a genuine space where people can slow down, breathe, and reconnect with themselves.
        </p>
        <p>
          We draw from the deep roots of Hatha Yoga and the meditative tradition of Sound Healing,
          offering practices that are both time-honoured and accessible to modern life.
        </p>
        <p class="font-light text-stone">
          Whether you are a complete beginner or an experienced practitioner, you are welcome here.
        </p>
      </div>

      <!-- Stats -->
      <div class="mt-14 grid grid-cols-3 gap-8 pt-10 border-t border-line">
        <div class="stagger-child">
          <div class="font-serif text-5xl text-gold mb-2"><span class="stat-count" data-target="11" data-suffix="+">11+</span></div>
          <div class="text-[10px] font-sans font-bold uppercase tracking-widest3 text-muted">Services</div>
        </div>
        <div class="stagger-child">
          <div class="font-serif text-5xl text-gold mb-2"><span class="stat-count" data-target="2" data-suffix="×">2×</span></div>
          <div class="text-[10px] font-sans font-bold uppercase tracking-widest3 text-muted">Daily Classes</div>
        </div>
        <div class="stagger-child">
          <div class="font-serif text-5xl text-gold mb-2">All</div>
          <div class="text-[10px] font-sans font-bold uppercase tracking-widest3 text-muted">Levels</div>
        </div>
      </div>
    </div>

  </div>

  <!-- Management Team & Trainers -->
  <div class="max-w-7xl mx-auto mt-20 pt-16 border-t border-line relative z-10">

    <!-- Management Team -->
    <div class="mb-20 fade-up">
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center gap-4 mb-6">
          <span class="w-12 h-px bg-gold/50"></span>
          <p class="text-[11px] font-sans font-bold uppercase tracking-widest3 text-gold">Leadership</p>
          <span class="w-12 h-px bg-gold/50"></span>
        </div>
        <h3 class="font-serif text-3xl md:text-4xl font-medium text-stone">Management Team</h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <!-- Aarati Dhakal -->
        <div class="team-card stagger-child">
          <div class="team-avatar">
            <span class="font-serif text-3xl text-gold">AD</span>
          </div>
          <h4 class="font-serif text-2xl font-medium text-stone mb-2">Aarati Dhakal</h4>
          <p class="text-[10px] font-sans font-bold uppercase tracking-widest3 text-gold mb-4">Founder, Pragya Path</p>
          <p class="font-sans text-sm text-muted font-light leading-relaxed">Dedicated to sharing authentic yoga and sound healing traditions with the world.</p>
        </div>

        <!-- Anil Basnet -->
        <div class="team-card stagger-child">
          <div class="team-avatar">
            <span class="font-serif text-3xl text-gold">AB</span>
          </div>
          <h4 class="font-serif text-2xl font-medium text-stone mb-2">Anil Basnet</h4>
          <p class="text-[10px] font-sans font-bold uppercase tracking-widest3 text-gold mb-4">Founder, Kalanil Art Gallery</p>
          <p class="font-sans text-sm text-muted font-light leading-relaxed">Bringing art and creativity together with wellness and healing.</p>
        </div>
      </div>
    </div>

    <!-- Our Trainers -->
    <div class="fade-up">
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center gap-4 mb-6">
          <span class="w-12 h-px bg-gold/50"></span>
          <p class="text-[11px] font-sans font-bold uppercase tracking-widest3 text-gold">Expert Guidance</p>
          <span class="w-12 h-px bg-gold/50"></span>
        </div>
        <h3 class="font-serif text-3xl md:text-4xl font-medium text-stone">Our Trainers</h3>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
        <% const trainers = [
          { name: 'Aarati Dhakal', initials: 'AD' },
          { name: 'Sumon Acharya', initials: 'SA' },
          { name: 'Ramash Kadel', initials: 'RK' },
          { name: 'Meena K. Raut', initials: 'MR' },
          { name: 'Kalpana Gajmer', initials: 'KG' }
        ]; %>

        <% trainers.forEach(function(t) { %>
        <div class="team-card-sm group stagger-child">
          <div class="team-avatar-sm">
            <span class="font-serif text-2xl text-gold"><%= t.initials %></span>
          </div>
          <h4 class="font-serif text-lg font-medium text-stone"><%= t.name %></h4>
        </div>
        <% }) %>
      </div>
    </div>

  </div>
</section>

