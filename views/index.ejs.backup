<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="overflow-x-hidden">

<!-- ═══════════════════════════════════════════════
     HERO
════════════════════════════════════════════════ -->
<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-ink" aria-label="Hero">

  <!-- Background image with luxury overlay -->
  <div class="absolute inset-0 transition-transform duration-[20000ms] ease-out scale-105 hover:scale-110">
    <img
      src="/images/hero.png"
      alt=""
      role="presentation"
      class="w-full h-full object-cover opacity-90"
      loading="eager"
    >
    <!-- Gradient shifting from left (dark for text) to right (transparent for the subject) -->
    <div class="absolute inset-0 bg-gradient-to-r from-base via-base/60 to-transparent"></div>
    <!-- Bottom fade to blend seamlessly into the next section -->
    <div class="absolute bottom-0 left-0 right-0 h-48 bg-gradient-to-t from-base to-transparent"></div>
    <!-- Top shadow gradient specifically to guarantee Navigation legibility -->
    <div class="absolute top-0 left-0 right-0 h-32 bg-gradient-to-b from-base/80 to-transparent z-0"></div>
    <!-- Radial vignette for cinematic depth -->
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 70% 50%, transparent 30%, rgba(15,56,61,0.25) 100%);"></div>
    <!-- Grain texture -->
    <div class="grain"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-12 text-left pt-32 md:pt-40 pb-20">
    <div class="max-w-3xl flex flex-col items-start">
      <div class="badge hero-reveal">
        <span class="badge-dot"></span>
        <p class="text-[10px] font-sans font-bold uppercase tracking-widest3">Bhaktapur, Nepal</p>
      </div>
      
      <h1 class="font-serif text-5xl sm:text-6xl md:text-[7.5rem] lg:text-[8.5rem] text-stone font-medium leading-[1.1] md:leading-[1.0] mb-8 md:mb-10 hero-reveal d1 drop-shadow-2xl">
        Awaken.<br>Heal.<br><span class="italic text-gold">Transform.</span>
      </h1>
      
      <p class="font-sans text-stone/80 text-lg md:text-2xl font-light leading-relaxed max-w-xl mb-10 hero-reveal d2">
        Traditional Hatha Yoga and Sound Healing in the ancient city of Bhaktapur. A quiet space to return to yourself.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-start gap-6 hero-reveal d3 w-full sm:w-auto">
        <a href="#services" class="btn-primary w-full sm:w-auto group">
          Begin Your Journey
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="#contact" class="btn-outline w-full sm:w-auto">
          Get in Touch
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll hint -->
  <div class="absolute bottom-12 left-6 md:left-12 flex flex-col items-center gap-3 hero-reveal d4">
    <div class="scroll-indicator-line"></div>
    <span class="text-[9px] font-sans uppercase tracking-widest3 text-stone/40 writing-mode-vertical" style="writing-mode: vertical-rl; letter-spacing: 0.35em;">Scroll</span>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     INTRO STRIP
════════════════════════════════════════════════ -->
<section class="bg-sage py-16 relative overflow-hidden" aria-label="Studio tagline">
  <div class="absolute -right-20 -top-20 w-64 h-64 bg-gold/10 rounded-full blur-3xl"></div>
  <div class="grain" style="opacity:0.02;"></div>

  <!-- Desktop: full quote layout -->
  <div class="hidden md:flex max-w-7xl mx-auto px-6 md:px-12 flex-col md:flex-row items-center justify-between gap-10 relative z-10">
    <p class="font-serif italic text-stone/90 text-2xl md:text-4xl font-medium text-center md:text-left leading-snug">
      "Yoga is not just repetition of few postures — it is more about the exploration and discovery of the subtle energies of life."
    </p>
    <div class="flex items-center gap-8 text-stone/60 text-[11px] font-sans uppercase tracking-widest2 shrink-0">
      <span class="flex items-center gap-2"><div class="w-1.5 h-1.5 bg-gold rounded-full"></div>Est. Bhaktapur</span>
      <span class="w-px h-6 bg-white/20"></span>
      <span class="flex items-center gap-2"><div class="w-1.5 h-1.5 bg-gold rounded-full"></div>All Levels Welcome</span>
    </div>
  </div>

  <!-- Mobile: marquee ticker -->
  <div class="md:hidden marquee-wrap relative z-10">
    <div class="marquee-track">
      <% const tagItems = [
        'Traditional Hatha Yoga', 'Sound Healing', 'Bhaktapur, Nepal', 'All Levels Welcome',
        'Tibetan Singing Bowls', 'Mindfulness Hikes', 'Yoga Teacher Training', 'Sacred Retreats',
        'Traditional Hatha Yoga', 'Sound Healing', 'Bhaktapur, Nepal', 'All Levels Welcome',
        'Tibetan Singing Bowls', 'Mindfulness Hikes', 'Yoga Teacher Training', 'Sacred Retreats'
      ]; %>
      <% tagItems.forEach(function(item) { %>
      <span class="flex items-center gap-6 px-8 py-4 text-[11px] font-sans font-bold uppercase tracking-widest2 text-stone/70 shrink-0">
        <span class="w-1.5 h-1.5 rounded-full bg-gold shrink-0"></span>
        <%= item %>
      </span>
      <% }); %>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════
     GRATITUDE (Crown Chakra)
════════════════════════════════════════════════ -->
<section id="gratitude" class="py-12 md:py-20 px-6 md:px-12 bg-surface relative overflow-hidden border-b border-line" aria-labelledby="gratitude-heading">
  <!-- Decorative background -->
  <div class="absolute -right-40 -top-40 w-[40rem] h-[40rem] bg-gold/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center relative z-10">

    <!-- Image -->
    <div class="fade-up order-2 lg:order-1 group relative">
      <!-- Tilted gold backing card -->
      <div class="absolute inset-0 bg-gold/10 rounded-none transform rotate-3 scale-105"
           style="transition: transform 1.5s cubic-bezier(0.4, 0, 0.2, 1); will-change: transform;"
           data-parallax-backing></div>
      <!-- Image wrapper lifts on hover; img-hover handles inner scale -->
      <div class="img-hover rounded-none shadow-2xl relative z-10"
           style="transition: transform 1.5s cubic-bezier(0.4, 0, 0.2, 1); will-change: transform;"
           data-parallax-main>
        <img
          src="/images/loard%20shive.png"
          alt="Lord Shiva - The Adiyogi"
          class="w-full aspect-[4/3] lg:aspect-square object-cover filter grayscale opacity-80"
          loading="lazy"
        >
      </div>
    </div>

    <!-- Text -->
    <div class="order-1 lg:order-2 fade-up delay-2">
      <div class="inline-flex items-center gap-4 mb-6">
        <span class="text-[11px] font-sans font-bold uppercase tracking-widest3 text-gold">Gratitude</span>
        <span class="w-16 h-px bg-gold/50"></span>
      </div>
      <h2 id="gratitude-heading" class="font-serif text-4xl md:text-5xl lg:text-6xl font-medium text-stone leading-tight mb-10">
        Honoring our <span class="italic text-gold">gurus</span>
      </h2>
      <div class="space-y-6 font-sans text-muted font-light leading-relaxed text-lg">
        <p>
          We bow in gratitude to the divine teachings of Lord Shiva, the Adiyogi, whose ancient wisdom of yoga and meditation forms the foundation of all our practices.
        </p>
        <p>
          Our guidance flows from a lineage of dedicated gurus who have preserved these sacred traditions. Through their blessings and teachings, we are able to share authentic practices that transform lives.
        </p>
        <p class="font-light text-stone">
          Every class, every session, every healing sound — all are offerings rooted in this timeless wisdom.
        </p>
      </div>

      <!-- Decorative element -->
      <div class="mt-12 flex items-center gap-4">
        <div class="w-16 h-px bg-gold/50"></div>
        <span class="font-serif italic text-gold text-lg">Namah Shivaya</span>
        <div class="w-16 h-px bg-gold/50"></div>
      </div>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════
     YOGA & SOUND HEALING PROGRAMS (Throat Chakra)
════════════════════════════════════════════════ -->
