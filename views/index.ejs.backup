      <div class="img-hover aspect-square bg-surface/30">
        <img src="/images/gallery/sound%20healing%20group.jpeg" alt="Group Healing Session" class="w-full h-full object-cover" loading="lazy">
      </div>
      <div class="img-hover aspect-square bg-surface/30">
        <img src="/images/gallery/girl-with-tibetean-bowl.png" alt="Tibetan Bowl Practice" class="w-full h-full object-cover" loading="lazy">
      </div>
      <div class="img-hover aspect-square bg-surface/30">
        <img src="/images/gallery/2O3A5972.jpg" alt="Yoga Session" class="w-full h-full object-cover" loading="lazy">
      </div>
      <div class="img-hover aspect-square bg-surface/30">
        <img src="/images/gallery/2O3A5994.jpg" alt="Sound Healing" class="w-full h-full object-cover" loading="lazy">
      </div>
      <div class="img-hover aspect-square bg-surface/30">
        <img src="/images/gallery/2O3A6005.jpg" alt="Yoga Practice" class="w-full h-full object-cover" loading="lazy">
      </div>
    </div>

      <!-- View All Button -->
      <div class="text-center mb-8">
        <button id="view-all-btn" class="btn-primary group">
          View All Photos (50)
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Videos Tab -->
    <div id="gallery-videos" class="gallery-content hidden">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-surface border border-line overflow-hidden group hover:border-gold transition-all duration-500">
          <div class="relative aspect-video bg-gradient-to-br from-ink via-surface to-base flex items-center justify-center img-hover">
            <div class="relative z-10 w-16 h-16 rounded-full border-2 border-gold/50 flex items-center justify-center group-hover:border-gold group-hover:scale-110 transition-all duration-500 cursor-pointer">
              <svg class="w-6 h-6 text-gold ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
          <div class="p-6">
            <h4 class="font-serif text-xl font-medium text-stone group-hover:text-gold transition-colors mb-2">Sound Healing Session</h4>
            <p class="font-sans text-sm text-muted font-light">Experience the healing power of Tibetan singing bowls</p>
          </div>
        </div>
        <div class="bg-surface border border-line overflow-hidden group hover:border-gold transition-all duration-500">
          <div class="relative aspect-video bg-gradient-to-br from-ink via-surface to-base flex items-center justify-center img-hover">
            <div class="relative z-10 w-16 h-16 rounded-full border-2 border-gold/50 flex items-center justify-center group-hover:border-gold group-hover:scale-110 transition-all duration-500 cursor-pointer">
              <svg class="w-6 h-6 text-gold ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
          <div class="p-6">
            <h4 class="font-serif text-xl font-medium text-stone group-hover:text-gold transition-colors mb-2">Morning Yoga Flow</h4>
            <p class="font-sans text-sm text-muted font-light">Traditional Hatha Yoga practice in the morning light</p>
          </div>
        </div>
        <div class="bg-surface border border-line overflow-hidden group hover:border-gold transition-all duration-500">
          <div class="relative aspect-video bg-gradient-to-br from-ink via-surface to-base flex items-center justify-center img-hover">
            <div class="relative z-10 w-16 h-16 rounded-full border-2 border-gold/50 flex items-center justify-center group-hover:border-gold group-hover:scale-110 transition-all duration-500 cursor-pointer">
              <svg class="w-6 h-6 text-gold ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
          <div class="p-6">
            <h4 class="font-serif text-xl font-medium text-stone group-hover:text-gold transition-colors mb-2">Singing Bowl Training</h4>
            <p class="font-sans text-sm text-muted font-light">Learn the art of playing Tibetan singing bowls</p>
          </div>
        </div>
        <div class="bg-surface border border-line overflow-hidden group hover:border-gold transition-all duration-500">
          <div class="relative aspect-video bg-gradient-to-br from-ink via-surface to-base flex items-center justify-center img-hover">
            <div class="relative z-10 w-16 h-16 rounded-full border-2 border-gold/50 flex items-center justify-center group-hover:border-gold group-hover:scale-110 transition-all duration-500 cursor-pointer">
              <svg class="w-6 h-6 text-gold ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
          <div class="p-6">
            <h4 class="font-serif text-xl font-medium text-stone group-hover:text-gold transition-colors mb-2">Retreat Highlights</h4>
            <p class="font-sans text-sm text-muted font-light">Moments from our yoga retreats in Nepal</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Full Screen Gallery Modal -->
<div id="gallery-modal" class="gallery-modal">
  <div class="gallery-modal-header">
    <div>
      <h3 class="font-serif text-xl font-medium text-stone">All Photos</h3>
      <p id="modal-counter" class="text-[10px] font-sans font-bold uppercase tracking-widest3 text-muted mt-1">50 photos</p>
    </div>
    <div class="flex items-center gap-4">
      <div class="hidden md:flex gap-2" id="modal-filters">
        <button data-filter="all" class="modal-filter active px-4 py-1.5 text-[9px] font-sans font-bold uppercase tracking-widest3 border border-gold bg-gold/10 text-gold rounded-full transition-all duration-300">All</button>
        <button data-filter="yoga" class="modal-filter px-4 py-1.5 text-[9px] font-sans font-bold uppercase tracking-widest3 border border-line text-muted rounded-full transition-all duration-300 hover:border-gold hover:text-gold">Yoga</button>
        <button data-filter="healing" class="modal-filter px-4 py-1.5 text-[9px] font-sans font-bold uppercase tracking-widest3 border border-line text-muted rounded-full transition-all duration-300 hover:border-gold hover:text-gold">Healing</button>
        <button data-filter="training" class="modal-filter px-4 py-1.5 text-[9px] font-sans font-bold uppercase tracking-widest3 border border-line text-muted rounded-full transition-all duration-300 hover:border-gold hover:text-gold">Training</button>
        <button data-filter="community" class="modal-filter px-4 py-1.5 text-[9px] font-sans font-bold uppercase tracking-widest3 border border-line text-muted rounded-full transition-all duration-300 hover:border-gold hover:text-gold">Community</button>
      </div>
      <button id="modal-close-btn" class="gallery-modal-close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>
  <div class="gallery-modal-body">
    <div id="modal-gallery-grid" class="gallery-masonry-modal"></div>
  </div>
</div>

<!-- Lightbox Modal -->
<div id="lightbox" class="lightbox">
  <button id="lightbox-close-btn" class="lightbox-close">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>
  <button id="lightbox-prev-btn" class="lightbox-nav lightbox-prev">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
    </svg>
  </button>
  <div class="lightbox-content">
    <img id="lightbox-img" src="" alt="">
  </div>
  <button id="lightbox-next-btn" class="lightbox-nav lightbox-next">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
  </button>
  <div id="lightbox-counter" class="lightbox-counter"></div>
</div>

<script>
(function() {
  // All gallery images data
  var allImages = [
    { src: '/images/gallery/sound%20healing%20group.jpeg', alt: 'Group Healing Session', cat: 'healing' },
    { src: '/images/gallery/girl-with-tibetean-bowl.png', alt: 'Tibetan Bowl Practice', cat: 'healing' },
    { src: '/images/gallery/healing%20sound.jpeg', alt: 'Sound Resonance', cat: 'healing' },
    { src: '/images/gallery/with%20foregin%20guest%20group%20photo.jpeg', alt: 'Global Community', cat: 'community' },
    { src: '/images/gallery/yoda%20session.jpeg', alt: 'Hatha Yoga Flow', cat: 'yoga' },
    { src: '/images/gallery/sound%20healing%20glimp.jpeg', alt: 'Vibrational Therapy', cat: 'healing' },
    { src: '/images/gallery/yoga%20traning.jpeg', alt: 'Teacher Training', cat: 'training' },
    { src: '/images/gallery/sound%20healing.jpeg', alt: 'Deep Meditation', cat: 'healing' },
    { src: '/images/gallery/group%20photo%20with%20guest.jpeg', alt: 'Sangha & Connection', cat: 'community' },
    { src: '/images/gallery/sound-healing.png', alt: 'Acoustic Healing', cat: 'healing' },
    { src: '/images/gallery/2O3A5972.jpg', alt: 'Yoga Session 1', cat: 'yoga' },
    { src: '/images/gallery/2O3A5975.jpg', alt: 'Yoga Session 2', cat: 'yoga' },
    { src: '/images/gallery/2O3A5978.jpg', alt: 'Yoga Session 3', cat: 'yoga' },
    { src: '/images/gallery/2O3A5983.jpg', alt: 'Yoga Session 4', cat: 'yoga' },
    { src: '/images/gallery/2O3A5994.jpg', alt: 'Sound Healing 1', cat: 'healing' },
    { src: '/images/gallery/2O3A5996.jpg', alt: 'Sound Healing 2', cat: 'healing' },
    { src: '/images/gallery/2O3A5997.jpg', alt: 'Sound Healing 3', cat: 'healing' },
    { src: '/images/gallery/2O3A5999.jpg', alt: 'Sound Healing 4', cat: 'healing' },
    { src: '/images/gallery/2O3A6000.jpg', alt: 'Sound Healing 5', cat: 'healing' },
    { src: '/images/gallery/2O3A6004.jpg', alt: 'Meditation Practice', cat: 'healing' },
    { src: '/images/gallery/2O3A6005.jpg', alt: 'Yoga Practice 1', cat: 'yoga' },
    { src: '/images/gallery/2O3A6009.jpg', alt: 'Yoga Practice 2', cat: 'yoga' },
    { src: '/images/gallery/2O3A6010.jpg', alt: 'Yoga Practice 3', cat: 'yoga' },
    { src: '/images/gallery/2O3A6012.jpg', alt: 'Training 1', cat: 'training' },
    { src: '/images/gallery/2O3A6013.jpg', alt: 'Training 2', cat: 'training' },
    { src: '/images/gallery/2O3A6014.jpg', alt: 'Training 3', cat: 'training' },
    { src: '/images/gallery/2O3A6019.jpg', alt: 'Singing Bowl', cat: 'healing' },
    { src: '/images/gallery/2O3A6022.jpg', alt: 'Yoga Flow 1', cat: 'yoga' },
    { src: '/images/gallery/2O3A6023.jpg', alt: 'Yoga Flow 2', cat: 'yoga' },
    { src: '/images/gallery/2O3A6024.jpg', alt: 'Yoga Flow 3', cat: 'yoga' },
    { src: '/images/gallery/2O3A6025.jpg', alt: 'Sound Therapy', cat: 'healing' },
    { src: '/images/gallery/2O3A6027.jpg', alt: 'Group Practice', cat: 'community' },
    { src: '/images/gallery/2O3A6029.jpg', alt: 'Community Session', cat: 'community' },
    { src: '/images/gallery/2O3A6034.jpg', alt: 'Yoga Class 1', cat: 'yoga' },
    { src: '/images/gallery/2O3A6035.jpg', alt: 'Yoga Class 2', cat: 'yoga' },
    { src: '/images/gallery/2O3A6038.jpg', alt: 'Healing Circle', cat: 'healing' },
    { src: '/images/gallery/2O3A6039.jpg', alt: 'Sound Bath', cat: 'healing' },
    { src: '/images/gallery/2O3A6040.jpg', alt: 'Meditation Group', cat: 'healing' },
    { src: '/images/gallery/2O3A6041.jpg', alt: 'Yoga Retreat 1', cat: 'training' },
    { src: '/images/gallery/2O3A6042.jpg', alt: 'Yoga Retreat 2', cat: 'training' },
    { src: '/images/gallery/2O3A6044.jpg', alt: 'Bowl Healing', cat: 'healing' },
    { src: '/images/gallery/2O3A6045.jpg', alt: 'Sound Session', cat: 'healing' },
    { src: '/images/gallery/2O3A6047.jpg', alt: 'Yoga Workshop', cat: 'training' },
    { src: '/images/gallery/2O3A6054.jpg', alt: 'Group Healing 2', cat: 'healing' },
    { src: '/images/gallery/2O3A6056.jpg', alt: 'Yoga Practice 4', cat: 'yoga' },
    { src: '/images/gallery/2O3A6060.jpg', alt: 'Sound Healing 6', cat: 'healing' },
    { src: '/images/gallery/2O3A6062.jpg', alt: 'Yoga Session 5', cat: 'yoga' },
    { src: '/images/gallery/2O3A6064.jpg', alt: 'Meditation Session', cat: 'healing' },
    { src: '/images/gallery/2O3A6066.jpg', alt: 'Training Workshop', cat: 'training' },
    { src: '/images/gallery/2O3A6068.jpg', alt: 'Final Session', cat: 'community' }
  ];

  var currentFilter = 'all';
  var lightboxIndex = 0;
  var filteredImages = allImages.slice();

  // Elements
  var modal = document.getElementById('gallery-modal');
  var lightbox = document.getElementById('lightbox');
  var modalGrid = document.getElementById('modal-gallery-grid');
  var modalCounter = document.getElementById('modal-counter');
  var lightboxImg = document.getElementById('lightbox-img');
  var lightboxCounter = document.getElementById('lightbox-counter');

  // Tab switching
  document.getElementById('tab-photos').addEventListener('click', function() {
    document.getElementById('gallery-photos').classList.remove('hidden');
    document.getElementById('gallery-videos').classList.add('hidden');
    this.classList.add('active', 'bg-gold', 'text-white', 'border-gold');
    this.classList.remove('text-muted', 'border-line');
    document.getElementById('tab-videos').classList.remove('active', 'bg-gold', 'text-white', 'border-gold');
    document.getElementById('tab-videos').classList.add('text-muted', 'border-line');
  });

  document.getElementById('tab-videos').addEventListener('click', function() {
    document.getElementById('gallery-videos').classList.remove('hidden');
    document.getElementById('gallery-photos').classList.add('hidden');
    this.classList.add('active', 'bg-gold', 'text-white', 'border-gold');
    this.classList.remove('text-muted', 'border-line');
    document.getElementById('tab-photos').classList.remove('active', 'bg-gold', 'text-white', 'border-gold');
    document.getElementById('tab-photos').classList.add('text-muted', 'border-line');
  });

  // View All button - open modal
  document.getElementById('view-all-btn').addEventListener('click', function() {
    currentFilter = 'all';
    renderModal();
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  });

  // Close modal
  document.getElementById('modal-close-btn').addEventListener('click', function() {
    modal.classList.remove('active');
    document.body.style.overflow = '';
  });

  // Modal filter buttons
  document.getElementById('modal-filters').addEventListener('click', function(e) {
    var btn = e.target.closest('.modal-filter');
    if (!btn) return;
    
    document.querySelectorAll('.modal-filter').forEach(function(b) {
      b.classList.remove('active', 'bg-gold/10', 'text-gold', 'border-gold');
      b.classList.add('text-muted', 'border-line');
    });
    btn.classList.add('active', 'bg-gold/10', 'text-gold', 'border-gold');
    btn.classList.remove('text-muted', 'border-line');
    
    currentFilter = btn.getAttribute('data-filter');
    renderModal();
  });

  function renderModal() {
    filteredImages = currentFilter === 'all' ? allImages.slice() : allImages.filter(function(img) { return img.cat === currentFilter; });
    modalCounter.textContent = filteredImages.length + ' photos';

    var html = '';
    filteredImages.forEach(function(img, i) {
      html += '<div class="gallery-masonry-item img-hover cursor-pointer" data-idx="' + i + '">' +
        '<img src="' + img.src + '" alt="' + img.alt + '" class="w-full object-cover" loading="lazy">' +
        '<div class="img-caption"><p class="font-sans text-[9px] font-bold uppercase tracking-widest3 text-white/90">' + img.alt + '</p></div>' +
        '</div>';
    });
    modalGrid.innerHTML = html;

    // Add click handlers to modal images
    modalGrid.querySelectorAll('[data-idx]').forEach(function(el) {
      el.addEventListener('click', function() {
        lightboxIndex = parseInt(this.getAttribute('data-idx'));
        openLightbox();
      });
    });
  }

  // Lightbox
  function openLightbox() {
    var img = filteredImages[lightboxIndex];
    lightboxImg.src = img.src;
    lightboxImg.alt = img.alt;
    lightboxCounter.textContent = (lightboxIndex + 1) + ' / ' + filteredImages.length;
    lightbox.classList.add('active');
  }

  document.getElementById('lightbox-close-btn').addEventListener('click', function() {
    lightbox.classList.remove('active');
  });

  document.getElementById('lightbox-prev-btn').addEventListener('click', function() {
    lightboxIndex = (lightboxIndex - 1 + filteredImages.length) % filteredImages.length;
    openLightbox();
  });

  document.getElementById('lightbox-next-btn').addEventListener('click', function() {
    lightboxIndex = (lightboxIndex + 1) % filteredImages.length;
    openLightbox();
  });

  // Keyboard
  document.addEventListener('keydown', function(e) {
    if (lightbox.classList.contains('active')) {
      if (e.key === 'Escape') lightbox.classList.remove('active');
      if (e.key === 'ArrowLeft') { lightboxIndex = (lightboxIndex - 1 + filteredImages.length) % filteredImages.length; openLightbox(); }
      if (e.key === 'ArrowRight') { lightboxIndex = (lightboxIndex + 1) % filteredImages.length; openLightbox(); }
    } else if (modal.classList.contains('active')) {
      if (e.key === 'Escape') { modal.classList.remove('active'); document.body.style.overflow = ''; }
    }
  });

  // Click outside modal to close
  modal.addEventListener('click', function(e) {
    if (e.target === modal) {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }
  });
})();
</script>


<!-- ═══════════════════════════════════════════════
     NEWSROOMS (Sacral Chakra)
════════════════════════════════════════════════ -->
<section id="newsrooms" class="py-12 md:py-16 px-6 md:px-12 bg-surface border-b border-line" aria-labelledby="newsrooms-heading">
  <div class="max-w-7xl mx-auto relative z-10">

    <!-- Header -->
    <div class="mb-16 md:mb-24 text-center max-w-2xl mx-auto fade-up">
      <div class="inline-flex items-center justify-center gap-4 mb-6">
        <span class="w-12 h-px bg-gold/50"></span>
        <p class="text-[11px] font-sans font-bold uppercase tracking-widest3 text-gold">Newsrooms</p>
        <span class="w-12 h-px bg-gold/50"></span>
      </div>
      <h2 id="newsrooms-heading" class="font-serif text-4xl md:text-5xl lg:text-6xl font-medium text-stone leading-tight">
        Stay <span class="italic text-gold">informed</span>
      </h2>
      <p class="mt-6 font-sans text-muted font-light text-lg">
        Read our latest articles, news, and interviews about yoga, wellness, and spiritual growth.
      </p>
    </div>

    <!-- Articles -->
    <div class="mb-16 fade-up">
      <div class="flex items-center gap-4 mb-8">
        <span class="w-12 h-px bg-gold/50"></span>
        <h3 class="font-serif text-2xl md:text-3xl font-medium text-stone">Articles</h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% const articles = [
          { title: 'The Benefits of Daily Yoga Practice', excerpt: 'Discover how a consistent yoga routine can transform your physical and mental well-being.', date: 'Coming Soon' },
          { title: 'Understanding Sound Healing', excerpt: 'Learn about the ancient tradition of using sound vibrations for healing and relaxation.', date: 'Coming Soon' },
          { title: 'Mindfulness in Everyday Life', excerpt: 'Simple techniques to bring mindfulness into your daily activities and relationships.', date: 'Coming Soon' }
        ]; %>

        <% articles.forEach(function(a) { %>
        <article class="article-card group stagger-child">
          <div class="text-[10px] font-sans font-bold uppercase tracking-widest3 text-gold mb-4"><%= a.date %></div>
          <h4 class="font-serif text-xl font-medium text-stone mb-4"><%= a.title %></h4>
          <p class="font-sans text-muted font-light leading-relaxed mb-6"><%= a.excerpt %></p>
          <a href="#" class="btn-ghost">
            Read More
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </article>
        <% }) %>
      </div>
    </div>

    <!-- Online News -->
    <div class="mb-16 fade-up">
      <div class="flex items-center gap-4 mb-8">
        <span class="w-12 h-px bg-gold/50"></span>
        <h3 class="font-serif text-2xl md:text-3xl font-medium text-stone">Online News</h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% const news = [
          { title: 'Pragya Path Hosts International Yoga Retreat', source: 'Nepal Wellness Today', date: 'Coming Soon' },
          { title: 'Sound Healing: A Growing Trend in Nepal', source: 'Kathmandu Post', date: 'Coming Soon' },
          { title: 'Bhaktapur Becomes a Hub for Spiritual Tourism', source: 'Tourism Weekly', date: 'Coming Soon' }
        ]; %>

        <% news.forEach(function(n) { %>
        <article class="article-card group stagger-child">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-[10px] font-sans font-bold uppercase tracking-widest3 text-gold"><%= n.date %></span>
            <span class="w-1 h-1 bg-gold rounded-full"></span>
            <span class="text-[10px] font-sans font-bold uppercase tracking-widest3 text-muted"><%= n.source %></span>
          </div>
          <h4 class="font-serif text-lg font-medium text-stone"><%= n.title %></h4>
        </article>
        <% }) %>
      </div>
    </div>

    <!-- Interviews -->
    <div class="fade-up">
      <div class="flex items-center gap-4 mb-8">
        <span class="w-12 h-px bg-gold/50"></span>
        <h3 class="font-serif text-2xl md:text-3xl font-medium text-stone">Interviews</h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% const interviews = [
          { name: 'Aarati Dhakal', role: 'Founder, Pragya Path', topic: 'Her journey into yoga and sound healing' },
          { name: 'Anil Basnet', role: 'Founder, Kalanil Art Gallery', topic: 'The intersection of art and wellness' },
          { name: 'Sumon Acharya', role: 'Senior Trainer', topic: 'Teaching yoga to international students' }
        ]; %>

        <% interviews.forEach(function(interview) { %>
        <article class="article-card group stagger-child">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-gold/20 to-sage flex items-center justify-center border border-gold/30">
              <span class="font-serif text-sm text-gold"><%= interview.name.split(' ').map(n => n[0]).join('') %></span>
            </div>
            <div>
              <h4 class="font-serif text-lg font-medium text-stone"><%= interview.name %></h4>
              <p class="text-[10px] font-sans font-bold uppercase tracking-widest3 text-gold"><%= interview.role %></p>
            </div>
          </div>
          <p class="font-sans text-sm text-muted font-light italic">"<%= interview.topic %>"</p>
        </article>
        <% }) %>
      </div>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════
     CONTACT
════════════════════════════════════════════════ -->
<section id="contact" class="py-12 md:py-16 px-6 md:px-12 bg-base relative overflow-hidden" aria-labelledby="contact-heading">
  <!-- Decorative background -->
  <div class="absolute -right-40 bottom-0 w-[50rem] h-[50rem] bg-gold/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 relative z-10">

    <!-- Left: info -->
    <div class="fade-up">
      <div class="inline-flex items-center gap-4 mb-6">
        <span class="text-[11px] font-sans font-bold uppercase tracking-widest3 text-gold">Get in Touch</span>
        <span class="w-16 h-px bg-gold/50"></span>
      </div>
      <h2 id="contact-heading" class="font-serif text-6xl md:text-7xl font-medium text-stone leading-tight mb-8">
        We'd love to<br><span class="italic text-gold">hear from you</span>
      </h2>
      <p class="font-sans text-muted font-light leading-relaxed text-lg mb-10 max-w-md">
        Whether you have a question about classes, want to arrange a retreat,
        or simply want to know more — reach out and we'll get back to you soon.
      </p>

      <address class="not-italic space-y-10">
        <a href="tel:+9779828589863" class="flex items-center gap-8 group">
          <div class="w-16 h-16 rounded-full border border-line flex items-center justify-center shrink-0 group-hover:border-gold group-hover:scale-110 transition-all duration-500">
            <svg class="w-6 h-6 text-muted group-hover:text-gold transition-colors" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 3z"/>
            </svg>
          </div>
          <div>
            <div class="text-[10px] font-sans font-bold uppercase tracking-widest3 text-muted mb-2">Phone</div>
            <div class="font-serif text-3xl text-stone group-hover:text-gold transition-colors">+977 9828589863</div>
          </div>
        </a>

        <a href="mailto:pragyapath1@gmail.com" class="flex items-center gap-8 group">
          <div class="w-16 h-16 rounded-full border border-line flex items-center justify-center shrink-0 group-hover:border-gold group-hover:scale-110 transition-all duration-500">
            <svg class="w-6 h-6 text-muted group-hover:text-gold transition-colors" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
            </svg>
          </div>
          <div>
            <div class="text-[10px] font-sans font-bold uppercase tracking-widest3 text-muted mb-2">Email</div>
            <div class="font-serif text-3xl text-stone group-hover:text-gold transition-colors">pragyapath1@gmail.com</div>
          </div>
        </a>

        <div class="flex items-center gap-8 group">
          <div class="w-16 h-16 rounded-full border border-line flex items-center justify-center shrink-0 group-hover:border-gold group-hover:scale-110 transition-all duration-500">
            <svg class="w-6 h-6 text-muted group-hover:text-gold transition-colors" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div>
            <div class="text-[10px] font-sans font-bold uppercase tracking-widest3 text-muted mb-2">Location</div>
            <div class="font-serif text-3xl text-stone group-hover:text-gold transition-colors">Dattatraye, Bhaktapur, Nepal</div>
          </div>
        </div>
      </address>

      <!-- Social Media Links -->
      <div class="mt-12 pt-8 border-t border-line/50">
        <div class="text-[10px] font-sans font-bold uppercase tracking-widest3 text-muted mb-6">Follow Us</div>
        <div class="flex flex-wrap gap-4">
          <!-- WhatsApp -->
          <a href="https://wa.me/9779828589863" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="social-icon">
            <svg fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
          <!-- Facebook -->
          <a href="https://www.facebook.com/profile.php?id=61587079890163" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-icon">
            <svg fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <!-- Instagram -->
          <a href="https://www.instagram.com/pragyapath1/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-icon">
            <svg fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
          <!-- TikTok -->
          <a href="https://www.tiktok.com/@pragyapath1" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="social-icon">
            <svg fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 0010.86 4.48V13.2a8.16 8.16 0 005.58 2.16v-3.45a4.85 4.85 0 01-5.58-2.72V2h3.45v2.54a4.83 4.83 0 013.77-1.35z"/>
            </svg>
           </a>
         </div>
       </div>
     </div>

    <!-- Right: form -->
    <div class="fade-up delay-2 bg-surface p-8 md:p-16 relative">
      <div class="absolute top-0 left-0 w-[3px] h-full bg-gradient-to-b from-gold via-gold/50 to-transparent"></div>
      <form action="/inquiry" method="POST" novalidate class="space-y-10" id="inquiry-form">
        <% const errors = locals.errors || {}; const values = locals.values || {}; %>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-10">
          <div class="form-group">
            <input
              type="text" id="name" name="name"
              value="<%= values.name || '' %>"
              placeholder=" "
              required
              class="form-input <%= errors.name ? 'form-input-error' : '' %>"
              autocomplete="name"
            >
            <label for="name" class="form-label">Name *</label>
            <% if (errors.name) { %>
            <p class="mt-2 text-[10px] font-sans text-red-500 uppercase tracking-widest2"><%= errors.name %></p>
            <% } %>
          </div>
          <div class="form-group">
            <input
              type="email" id="email" name="email"
              value="<%= values.email || '' %>"
              placeholder=" "
              required
              class="form-input <%= errors.email ? 'form-input-error' : '' %>"
              autocomplete="email"
            >
            <label for="email" class="form-label">Email *</label>
            <% if (errors.email) { %>
            <p class="mt-2 text-[10px] font-sans text-red-500 uppercase tracking-widest2"><%= errors.email %></p>
            <% } %>
          </div>
        </div>

        <div class="form-group">
          <input
            type="tel" id="phone" name="phone"
            value="<%= values.phone || '' %>"
            placeholder=" "
            class="form-input <%= errors.phone ? 'form-input-error' : '' %>"
            autocomplete="tel"
          >
          <label for="phone" class="form-label">Phone <span class="normal-case tracking-normal font-light text-muted">(optional)</span></label>
        </div>

        <div class="form-group">
          <textarea
            id="message" name="message"
            rows="4"
            placeholder=" "
            required
            class="form-input resize-none <%= errors.message ? 'form-input-error' : '' %>"
          ><%= values.message || '' %></textarea>
          <label for="message" class="form-label">Message *</label>
          <% if (errors.message) { %>
          <p class="mt-2 text-[10px] font-sans text-red-500 uppercase tracking-widest2"><%= errors.message %></p>
          <% } %>
        </div>

        <button
          type="submit" id="submit-btn"
          class="btn-primary w-full py-6 mt-8 group">
          <span>Send Message</span>
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </button>
      </form>
    </div>

  </div>
</section>

</main>

<!-- Scroll reveal -->
<script>
(function () {
  // Hero reveal animations — fire immediately
  document.querySelectorAll('.hero-reveal').forEach(function (el) { el.classList.add('visible'); });

  // ── Stagger-child observer ──────────────────────────────────────────────
  // When a parent container scrolls into view, reveal its children sequentially.
  var staggerParents = new Set();
  document.querySelectorAll('.stagger-child').forEach(function(el) {
    staggerParents.add(el.parentElement);
  });

  var staggerIO = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (!entry.isIntersecting) return;
      var children = Array.from(entry.target.querySelectorAll('.stagger-child'));
      children.forEach(function(child, i) {
        setTimeout(function() {
          child.classList.add('visible');
        }, i * 75);
      });
      staggerIO.unobserve(entry.target);
    });
  }, { threshold: 0.08 });

  staggerParents.forEach(function(parent) { staggerIO.observe(parent); });

  // ── Fade-up observer ───────────────────────────────────────────────────
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.fade-up').forEach(function (el) { io.observe(el); });

  // ── Counter animation ──────────────────────────────────────────────────
  function animateCounter(el) {
    var target = parseInt(el.getAttribute('data-target'), 10);
    var suffix = el.getAttribute('data-suffix') || '';
    if (isNaN(target)) return;
    var duration = 1200;
    var start = null;
    function step(ts) {
      if (!start) start = ts;
      var progress = Math.min((ts - start) / duration, 1);
      // Ease out cubic
      var eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.round(eased * target) + suffix;
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }
  var counterIO = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (!entry.isIntersecting) return;
      animateCounter(entry.target);
      counterIO.unobserve(entry.target);
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.stat-count[data-target]').forEach(function(el) {
    counterIO.observe(el);
  });

  // ── Lazy image loading ─────────────────────────────────────────────────
  document.querySelectorAll('img[loading="lazy"]').forEach(function (img) {
    if (img.complete) {
      img.classList.add('loaded');
    } else {
      img.addEventListener('load', function () { img.classList.add('loaded'); });
    }
  });

  // ── Parallax hover — Gratitude & About image blocks ───────────────────
  // Each group: [data-parallax-backing] tilts more, [data-parallax-main] lifts,
  // [data-parallax-float] lifts + rotates, inner img greyscale clears.
  document.querySelectorAll('[data-parallax-main]').forEach(function(main) {
    var group = main.closest('.group, [class*="group"]') || main.parentElement;
    var backing = group.querySelector('[data-parallax-backing]');
    var floatEl = group.querySelector('[data-parallax-float]');
    var floatImg = floatEl ? floatEl.querySelector('img') : null;

    group.addEventListener('mouseenter', function() {
      if (main)    main.style.transform    = 'translateY(-10px) translateZ(0)';
      if (backing) backing.style.transform = 'rotate(5deg) scale(1.05)';
      if (floatEl) floatEl.style.transform = 'translateY(-12px) rotate(4deg) scale(1.04) translateZ(0)';
      if (floatImg) {
        floatImg.style.filter  = 'grayscale(0)';
        floatImg.style.opacity = '1';
      }
    });
    group.addEventListener('mouseleave', function() {
      if (main)    main.style.transform    = 'translateY(0) translateZ(0)';
      if (backing) backing.style.transform = 'rotate(3deg) scale(1.05)';
      if (floatEl) floatEl.style.transform = 'translateY(0) rotate(0deg) scale(1) translateZ(0)';
      if (floatImg) {
        floatImg.style.filter  = 'grayscale(1)';
        floatImg.style.opacity = '0.8';
      }
    });
  });

  // ── Form submit state ──────────────────────────────────────────────────
  var form = document.getElementById('inquiry-form');
  var btn  = document.getElementById('submit-btn');
  if (form && btn) {
    form.addEventListener('submit', function () {
      btn.innerHTML = '<span>Sending...</span><svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';
      btn.disabled = true;
      btn.classList.add('opacity-60', 'cursor-not-allowed');
    });
  }

  // ── Smooth scroll for anchor links ────────────────────────────────────
  document.querySelectorAll('a[href^="#"]').forEach(function (anchor) {
    anchor.addEventListener('click', function (e) {
      var href = this.getAttribute('href');
      if (href === '#') return;
      var target = document.querySelector(href);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
})();
</script>

<%- include('partials/footer') %>
